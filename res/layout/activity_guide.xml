<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/mainBg"
    android:fitsSystemWindows="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@id/tool_bar"
        layout="@layout/tool_bar" />
    <androidx.core.widget.NestedScrollView
        android:id="@id/mainContainerBg"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tool_bar">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="20.0dip"
            android:paddingBottom="32.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16.0dip"
            android:paddingEnd="16.0dip">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="22.0sp"
                android:textStyle="bold"
                android:id="@id/guide_intro_title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/guide_intro_title" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14.0sp"
                android:id="@id/guide_intro_text"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6.0dip"
                android:text="@string/guide_intro_text"
                android:lineSpacingExtra="2.0dip" />
            <com.google.android.material.button.MaterialButton
                android:id="@id/btn_toggle_full_tutorial"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.0dip"
                android:text="@string/guide_show_full_tutorial"
                app:icon="@drawable/ic_expand_more"
                style="@style/GuideOutlinedButton" />
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/guide_sections_container"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.0dip" />
            <androidx.cardview.widget.CardView
                android:id="@id/card_online_tutorials"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.0dip"
                app:cardCornerRadius="14.0dip"
                app:cardElevation="2.0dip">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@id/guide_online_icon"
                            android:padding="8.0dip"
                            android:layout_width="40.0dip"
                            android:layout_height="40.0dip"
                            android:src="@drawable/ic_globe"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no" />
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.0"
                            android:layout_marginStart="12.0dip">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="17.0sp"
                                android:textStyle="bold"
                                android:id="@id/guide_online_title"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/guide_online_title" />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="13.0sp"
                                android:id="@id/guide_online_text"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3.0dip"
                                android:text="@string/guide_online_text" />
                        </LinearLayout>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@id/btn_online_tutorials"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12.0dip"
                        android:text="@string/guide_online_action"
                        app:icon="@drawable/ic_globe"
                        style="@style/GuideOutlinedButton" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>