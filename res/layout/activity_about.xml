<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/mainBg"
    android:fitsSystemWindows="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@id/tool_bar"
        layout="@layout/tool_bar" />
    <ScrollView
        android:id="@id/mainContainerBg"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tool_bar">
        <LinearLayout
            android:orientation="vertical"
            android:padding="16.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="12.0dip"
                android:paddingBottom="24.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <androidx.cardview.widget.CardView
                    android:layout_width="100.0dip"
                    android:layout_height="100.0dip"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="20.0dip"
                    app:cardElevation="4.0dip">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@id/about_logo"
                        android:layout_width="95.0dip"
                        android:layout_height="95.0dip"
                        android:contentDescription="@string/app_name"
                        app:srcCompat="@drawable/ic_logo" />
                </androidx.cardview.widget.CardView>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="22.0sp"
                    android:typeface="sans"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16.0dip"
                    android:text="@string/app_name" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14.0sp"
                    android:id="@id/app_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dip"
                    android:text="@string/ui_version_1_0_0"
                    android:alpha="0.7" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="10.0sp"
                    android:id="@id/build_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_build_info"
                    android:alpha="0.5" />
            </LinearLayout>
            <androidx.cardview.widget.CardView
                android:id="@id/card_intro"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24.0dip"
                app:cardCornerRadius="12.0dip"
                app:cardElevation="2.0dip">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="16.0sp"
                        android:typeface="sans"
                        android:textStyle="bold"
                        android:textColor="?colorAccent"
                        android:id="@id/about_intro_title"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_about_intro_title" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="13.0sp"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6.0dip"
                        android:text="@string/ui_about_intro_description"
                        android:lineSpacingMultiplier="1.15"
                        android:alpha="0.78" />
                    <com.google.android.material.chip.ChipGroup
                        android:id="@id/about_intro_highlights_group"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12.0dip"
                        app:chipSpacingHorizontal="8.0dip"
                        app:chipSpacingVertical="8.0dip"
                        app:singleLine="false">
                        <com.google.android.material.chip.Chip
                            android:text="@string/ui_about_intro_multi_tunneling"
                            app:chipIcon="@drawable/ic_about_intro_tunnels"
                            style="@style/AboutInfoPill" />
                        <com.google.android.material.chip.Chip
                            android:text="@string/ui_about_intro_cloud_managed"
                            app:chipIcon="@drawable/ic_about_intro_cloud"
                            style="@style/AboutInfoPill" />
                        <com.google.android.material.chip.Chip
                            android:text="@string/ui_about_intro_api_ready"
                            app:chipIcon="@drawable/ic_about_intro_api"
                            style="@style/AboutInfoPill" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12.0sp"
                android:typeface="sans"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8.0dip"
                android:text="@string/ui_supported_tunnels"
                android:textAllCaps="true" />
            <androidx.cardview.widget.CardView
                android:id="@id/card_tunnels"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24.0dip"
                app:cardCornerRadius="12.0dip"
                app:cardElevation="2.0dip">
                <com.google.android.material.chip.ChipGroup
                    android:id="@id/supported_tunnels_group"
                    android:padding="12.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8.0dip"
                    app:chipSpacingVertical="8.0dip"
                    app:singleLine="false">
                    <com.google.android.material.chip.Chip
                        android:id="@id/tunnel_openvpn"
                        android:text="@string/openvpn"
                        app:chipIcon="@drawable/ic_tunnel_openvpn"
                        style="@style/AboutInfoPill" />
                    <com.google.android.material.chip.Chip
                        android:text="@string/ssh"
                        app:chipIcon="@drawable/ic_tunnel_ssh"
                        style="@style/AboutInfoPill" />
                    <com.google.android.material.chip.Chip
                        android:text="@string/v2ray"
                        app:chipIcon="@drawable/ic_tunnel_v2ray"
                        style="@style/AboutInfoPill" />
                    <com.google.android.material.chip.Chip
                        android:text="@string/ui_vless"
                        app:chipIcon="@drawable/ic_tunnel_v2ray"
                        style="@style/AboutInfoPill" />
                    <com.google.android.material.chip.Chip
                        android:text="@string/ui_vmess"
                        app:chipIcon="@drawable/ic_tunnel_v2ray"
                        style="@style/AboutInfoPill" />
                    <com.google.android.material.chip.Chip
                        android:text="@string/ui_shadowsocks"
                        app:chipIcon="@drawable/ic_tunnel_v2ray"
                        style="@style/AboutInfoPill" />
                    <com.google.android.material.chip.Chip
                        android:text="@string/ui_socks"
                        app:chipIcon="@drawable/ic_tunnel_v2ray"
                        style="@style/AboutInfoPill" />
                    <com.google.android.material.chip.Chip
                        android:text="@string/settings_http_port"
                        app:chipIcon="@drawable/ic_tunnel_http"
                        style="@style/AboutInfoPill" />
                    <com.google.android.material.chip.Chip
                        android:text="@string/ui_trojan"
                        app:chipIcon="@drawable/ic_tunnel_v2ray"
                        style="@style/AboutInfoPill" />
                    <com.google.android.material.chip.Chip
                        android:id="@id/tunnel_hysteria1"
                        android:text="@string/ui_hysteria1"
                        app:chipIcon="@drawable/ic_tunnel_hysteria"
                        style="@style/AboutInfoPill" />
                    <com.google.android.material.chip.Chip
                        android:id="@id/tunnel_hysteria2"
                        android:text="@string/ui_hysteria2"
                        app:chipIcon="@drawable/ic_tunnel_hysteria"
                        style="@style/AboutInfoPill" />
                    <com.google.android.material.chip.Chip
                        android:text="@string/ui_wireguard"
                        app:chipIcon="@drawable/ic_tunnel_v2ray"
                        style="@style/AboutInfoPill" />
                    <com.google.android.material.chip.Chip
                        android:text="@string/ui_slowdns_dnstt"
                        app:chipIcon="@drawable/ic_tunnel_dnstt"
                        style="@style/AboutInfoPill" />
                </com.google.android.material.chip.ChipGroup>
            </androidx.cardview.widget.CardView>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12.0sp"
                android:typeface="sans"
                android:textStyle="bold"
                android:id="@id/support_section_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8.0dip"
                android:text="@string/ui_support_and_community"
                android:textAllCaps="true" />
            <androidx.cardview.widget.CardView
                android:id="@id/card_support"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24.0dip"
                app:cardCornerRadius="12.0dip"
                app:cardElevation="2.0dip">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/support_links_container"
                    android:paddingTop="4.0dip"
                    android:paddingBottom="4.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content" />
            </androidx.cardview.widget.CardView>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12.0sp"
                android:typeface="sans"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8.0dip"
                android:text="@string/ui_legal_and_privacy"
                android:textAllCaps="true" />
            <androidx.cardview.widget.CardView
                android:id="@id/card_legal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24.0dip"
                app:cardCornerRadius="12.0dip"
                app:cardElevation="2.0dip">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="16.0dip"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="15.0sp"
                            android:typeface="sans"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_end_user_license_agreement" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="13.0sp"
                            android:id="@id/eula_text"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8.0dip"
                            android:text="@string/ui_license_agreement_n_nthis_end_user_license_agreement_eula_is_a_legal"
                            android:lineSpacingMultiplier="1.2" />
                    </LinearLayout>
                    <View
                        android:id="@id/legal_links_divider"
                        android:background="?colorControlNormal"
                        android:layout_width="fill_parent"
                        android:layout_height="1.0dip"
                        android:alpha="0.12"
                        android:layout_marginStart="16.0dip"
                        android:layout_marginEnd="16.0dip" />
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@id/legal_links_container"
                        android:paddingTop="4.0dip"
                        android:paddingBottom="4.0dip"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@id/card_security"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32.0dip"
                app:cardCornerRadius="12.0dip"
                app:cardElevation="2.0dip">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12.0sp"
                        android:typeface="sans"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8.0dip"
                        android:text="@string/ui_for_security_researchers"
                        android:textAllCaps="true" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12.0sp"
                        android:id="@id/security_research_note"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_security_research_note"
                        android:lineSpacingMultiplier="1.1"
                        android:alpha="0.8" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="11.0sp"
                android:gravity="center"
                android:id="@id/copyright"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16.0dip"
                android:text="@string/ui_value_2026_http_tweak_all_rights_reserved"
                android:alpha="0.4" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>