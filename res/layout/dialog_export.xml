<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_surface"
    android:padding="0.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:clipToOutline="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/tv_title"
        android:background="@drawable/bg_dialog_header"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="?actionBarSize"
        android:paddingStart="16.0dip"
        android:paddingEnd="8.0dip">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="18.0sp"
            android:id="@id/title"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/label_export_config"
            android:layout_weight="1.0" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@id/btn_cancel"
            android:text="@string/cr_cancel"
            style="@style/DialogActionButton.Tonal" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:padding="12.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@id/tv_export_toggle_extra"
            android:visibility="gone"
            android:layout_marginBottom="8.0dip"
            android:text="@string/expandable_extra_show"
            style="@style/CompactPill.Expandable" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/ll_export_extra_container"
            android:background="@drawable/spinner_bg_new"
            android:padding="12.0dip"
            android:visibility="visible"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10.0dip">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="13.0sp"
                android:typeface="sans"
                android:textStyle="bold"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_export_options" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="11.0sp"
                android:textColor="?android:textColorSecondary"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.0dip"
                android:layout_marginBottom="8.0dip"
                android:text="@string/ui_export_options_all_destinations" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatCheckBox
                    android:textSize="13.0sp"
                    android:id="@id/cb_enable_cloud_protected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_cloud_protection" />
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/info_enable_cloud_protected"
                    android:background="?selectableItemBackgroundBorderless"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="@dimen/info_icon_size"
                    android:layout_height="@dimen/info_icon_size"
                    android:src="@drawable/ic_info_standard"
                    android:contentDescription="@string/info"
                    android:layout_marginStart="2.0dip"
                    app:tint="?android:textColorSecondary"
                    style="@style/Widget.App.InfoIcon" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatCheckBox
                    android:textSize="13.0sp"
                    android:id="@id/cb_allow_config_resharing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_allow_config_resharing" />
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/info_allow_config_resharing"
                    android:background="?selectableItemBackgroundBorderless"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="@dimen/info_icon_size"
                    android:layout_height="@dimen/info_icon_size"
                    android:src="@drawable/ic_info_standard"
                    android:contentDescription="@string/info"
                    android:layout_marginStart="2.0dip"
                    app:tint="?android:textColorSecondary"
                    style="@style/Widget.App.InfoIcon" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatCheckBox
                    android:textSize="13.0sp"
                    android:id="@id/cb_revoke_device_access"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_remove_this_device_access" />
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/info_revoke_device_access"
                    android:background="?selectableItemBackgroundBorderless"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="@dimen/info_icon_size"
                    android:layout_height="@dimen/info_icon_size"
                    android:src="@drawable/ic_info_standard"
                    android:contentDescription="@string/info"
                    android:layout_marginStart="2.0dip"
                    app:tint="?android:textColorSecondary"
                    style="@style/Widget.App.InfoIcon" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/btn_copy_config"
            android:background="@drawable/spinner_bg_new"
            android:padding="10.0dip"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8.0dip">
            <ImageView
                android:id="@id/ic_copy_config"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:src="@drawable/ic_copy"
                app:tint="?colorOnSurface" />
            <ProgressBar
                android:id="@id/progress_copy_config"
                android:visibility="gone"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:indeterminate="true"
                android:indeterminateTint="?colorOnSurface" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:layout_marginStart="12.0dip">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14.0sp"
                    android:typeface="sans"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_copy_config" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="11.0sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_copy_contents_of_config" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/btn_export_file"
            android:background="@drawable/spinner_bg_new"
            android:padding="10.0dip"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8.0dip">
            <ImageView
                android:id="@id/ic_export_file"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:src="@drawable/ic_save"
                app:tint="?colorOnSurface" />
            <ProgressBar
                android:id="@id/progress_export_file"
                android:visibility="gone"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:indeterminate="true"
                android:indeterminateTint="?colorOnSurface" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:layout_marginStart="12.0dip">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14.0sp"
                    android:typeface="sans"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_export_to_file" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="11.0sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_save_configuration_as_a_ht_file" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/btn_share_config"
            android:background="@drawable/spinner_bg_new"
            android:padding="10.0dip"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8.0dip">
            <ImageView
                android:id="@id/ic_share_config"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:src="@drawable/ic_share"
                app:tint="?colorOnSurface" />
            <ProgressBar
                android:id="@id/progress_share_config"
                android:visibility="gone"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:indeterminate="true"
                android:indeterminateTint="?colorOnSurface" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:layout_marginStart="12.0dip">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14.0sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_share_config" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="11.0sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_share_config_with_another_app" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/layout_export_cloud_container"
            android:background="@drawable/spinner_bg_new"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/btn_export_cloud"
                android:paddingTop="0.0dip"
                android:paddingBottom="0.0dip"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingStart="0.0dip"
                android:paddingEnd="0.0dip">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10.0dip"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <ImageView
                        android:id="@id/ic_export_cloud"
                        android:layout_width="24.0dip"
                        android:layout_height="24.0dip"
                        android:src="@drawable/ic_cloud_up"
                        app:tint="?colorOnSurface" />
                    <ProgressBar
                        android:id="@id/progress_export_cloud"
                        android:visibility="gone"
                        android:layout_width="24.0dip"
                        android:layout_height="24.0dip"
                        android:indeterminate="true"
                        android:indeterminateTint="?colorOnSurface" />
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0"
                        android:layout_marginStart="12.0dip">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="14.0sp"
                            android:typeface="sans"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_export_to_cloud" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="11.0sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_upload_configuration_to_the_cloud" />
                    </LinearLayout>
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@id/btn_export_cloud_toggle"
                    android:background="?selectableItemBackgroundBorderless"
                    android:padding="12.0dip"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="56.0dip"
                    android:layout_height="fill_parent"
                    android:src="@drawable/ic_expand_more"
                    android:scaleType="center"
                    android:minWidth="56.0dip"
                    android:minHeight="0.0dip"
                    app:tint="?colorOnSurface" />
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/layout_export_cloud_options"
                android:paddingBottom="10.0dip"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingStart="10.0dip"
                android:paddingEnd="10.0dip">
                <androidx.appcompat.widget.AppCompatCheckBox
                    android:textSize="13.0sp"
                    android:id="@id/cb_export_show_qr"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_qr_code" />
                <androidx.appcompat.widget.AppCompatCheckBox
                    android:textSize="13.0sp"
                    android:id="@id/cb_export_cloud_one_time"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_one_time_import" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@id/til_export_cloud_expiry"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip"
                    android:hint="@string/ui_expiry_minutes"
                    style="@style/Widget.App.TextInputLayout">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@id/txt_export_cloud_expiry"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/ll_bulk_export_shared_note"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.0dip">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/info_icon_size"
                android:layout_height="@dimen/info_icon_size"
                android:src="@drawable/ic_info_standard"
                android:layout_marginEnd="6.0dip"
                app:tint="?android:textColorSecondary"
                style="@style/Widget.App.InfoIcon" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="11.0sp"
                android:textColor="?android:textColorSecondary"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="@string/ui_other_options_are_hidden_because_your_selection_includes_a_config_you_do"
                android:layout_weight="1.0" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12.0dip">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/info_icon_size"
                android:layout_height="@dimen/info_icon_size"
                android:src="@drawable/ic_info_standard"
                android:layout_marginEnd="6.0dip"
                app:tint="?android:textColorSecondary"
                style="@style/Widget.App.InfoIcon" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="11.0sp"
                android:textColor="?android:textColorSecondary"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="@string/ui_config_can_only_be_viewed_and_edited_on_the_device_it_was"
                android:layout_weight="1.0" />
        </LinearLayout>
    </LinearLayout>
</androidx.appcompat.widget.LinearLayoutCompat>