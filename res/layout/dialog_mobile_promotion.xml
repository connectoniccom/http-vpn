<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:background="@drawable/bg_mobile_promotion_dialog"
    android:padding="0.0dip"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:clipToOutline="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <WebView
        android:id="@id/promotion_webview"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:importantForAutofill="noExcludeDescendants" />
    <ProgressBar
        android:layout_gravity="center"
        android:id="@id/promotion_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="?android:progressBarStyle" />
    <TextView
        android:gravity="center"
        android:id="@id/promotion_error"
        android:padding="24.0dip"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:text="@string/mobile_promotion_load_error" />
    <androidx.appcompat.widget.AppCompatImageButton
        android:layout_gravity="end|center|top"
        android:id="@id/promotion_dialog_close"
        android:background="@drawable/bg_promotion_close"
        android:padding="8.0dip"
        android:layout_width="36.0dip"
        android:layout_height="36.0dip"
        android:layout_marginTop="0.0dip"
        android:scaleType="centerInside"
        android:contentDescription="@string/mobile_promotion_close"
        android:layout_marginEnd="0.0dip"
        android:elevation="2.0dip"
        app:srcCompat="@drawable/ic_close2"
        app:tint="?colorOnSurface" />
</FrameLayout>