<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_surface"
    android:padding="0.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:clipToOutline="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/tv_title"
        android:background="@drawable/bg_dialog_header"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="?actionBarSize"
        android:paddingStart="16.0dip"
        android:paddingEnd="8.0dip">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="18.0sp"
            android:id="@id/title"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/auto_reconnect"
            android:layout_weight="1.0" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@id/btn_reset"
            android:text="@string/settings_reset_action"
            style="@style/DialogActionButton.Tonal" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@id/btn_save"
            android:text="@string/settings_save"
            style="@style/DialogActionButton.Primary" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16.0dip"
            android:paddingEnd="16.0dip">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="13.0sp"
                android:textColor="?android:textColorSecondary"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12.0dip"
                android:layout_marginBottom="12.0dip"
                android:text="@string/auto_reconnect_dialog_description" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12.0sp"
                android:textStyle="bold"
                android:textColor="?colorPrimary"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8.0dip"
                android:text="@string/auto_reconnect_trigger_section"
                android:textAllCaps="true" />
            <androidx.appcompat.widget.SwitchCompat
                android:textStyle="bold"
                android:id="@id/switch_auto_reconnect"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4.0dip"
                android:text="@string/auto_reconnect_on_connection_loss" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12.0sp"
                android:textColor="?android:textColorSecondary"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8.0dip"
                android:text="@string/auto_reconnect_description"
                android:paddingStart="4.0dip"
                android:paddingEnd="4.0dip" />
            <androidx.appcompat.widget.SwitchCompat
                android:textStyle="bold"
                android:id="@id/switch_auto_reconnect_interval"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.0dip"
                android:layout_marginBottom="4.0dip"
                android:text="@string/auto_reconnect_by_interval" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12.0sp"
                android:textColor="?android:textColorSecondary"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8.0dip"
                android:text="@string/auto_reconnect_interval_description"
                android:paddingStart="4.0dip"
                android:paddingEnd="4.0dip" />
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/auto_reconnect_interval_fields"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12.0dip"
                android:paddingStart="4.0dip"
                android:paddingEnd="4.0dip">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@id/til_auto_reconnect_interval_minutes"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/auto_reconnect_interval_minutes"
                    app:helperText="@string/auto_reconnect_interval_helper"
                    style="@style/Widget.App.TextInputLayout">
                    <com.google.android.material.textfield.TextInputEditText
                        android:textSize="12.0sp"
                        android:id="@id/et_auto_reconnect_interval_minutes"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:maxLength="10"
                        android:digits="\ 0123456789"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <View
                android:background="?android:listDivider"
                android:layout_width="fill_parent"
                android:layout_height="1.0dip"
                android:layout_marginBottom="12.0dip" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12.0sp"
                android:textStyle="bold"
                android:textColor="?colorPrimary"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8.0dip"
                android:text="@string/auto_reconnect_settings_section"
                android:textAllCaps="true" />
            <androidx.appcompat.widget.SwitchCompat
                android:textStyle="bold"
                android:id="@id/switch_auto_reconnect_delay"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4.0dip"
                android:text="@string/auto_reconnect_delay" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12.0sp"
                android:textColor="?android:textColorSecondary"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10.0dip"
                android:text="@string/auto_reconnect_delay_description"
                android:paddingStart="4.0dip"
                android:paddingEnd="4.0dip" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@id/til_auto_reconnect_delay_seconds"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10.0dip"
                android:hint="@string/auto_reconnect_delay_seconds"
                app:helperText="@string/auto_reconnect_delay_minimum"
                style="@style/Widget.App.TextInputLayout">
                <com.google.android.material.textfield.TextInputEditText
                    android:textSize="12.0sp"
                    android:id="@id/et_auto_reconnect_delay_seconds"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:maxLength="10"
                    android:digits="\ 0123456789"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>
            <androidx.appcompat.widget.SwitchCompat
                android:textStyle="bold"
                android:id="@id/switch_auto_reconnect_timeout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4.0dip"
                android:text="@string/auto_reconnect_timeout_enable" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12.0sp"
                android:textColor="?android:textColorSecondary"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10.0dip"
                android:text="@string/auto_reconnect_timeout_description"
                android:paddingStart="4.0dip"
                android:paddingEnd="4.0dip" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@id/til_auto_reconnect_timeout_minutes"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10.0dip"
                android:hint="@string/auto_reconnect_timeout_minutes"
                app:helperText="@string/auto_reconnect_timeout_minimum"
                style="@style/Widget.App.TextInputLayout">
                <com.google.android.material.textfield.TextInputEditText
                    android:textSize="12.0sp"
                    android:id="@id/et_auto_reconnect_timeout_minutes"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:maxLength="10"
                    android:digits="\ 0123456789"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>
            <androidx.appcompat.widget.SwitchCompat
                android:textStyle="bold"
                android:id="@id/switch_reconnection_attempts"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4.0dip"
                android:text="@string/settings_reconnection_attempts_enable" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12.0sp"
                android:textColor="?android:textColorSecondary"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10.0dip"
                android:text="@string/settings_reconnection_attempts_description"
                android:paddingStart="4.0dip"
                android:paddingEnd="4.0dip" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@id/til_reconnection_attempts"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10.0dip"
                android:hint="@string/settings_reconnection_attempts_input"
                app:helperText="@string/settings_reconnection_attempts_helper"
                style="@style/Widget.App.TextInputLayout">
                <com.google.android.material.textfield.TextInputEditText
                    android:textSize="12.0sp"
                    android:id="@id/et_reconnection_attempts"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:maxLength="3"
                    android:digits="\ 0123456789"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12.0dip"
                android:layout_marginBottom="16.0dip">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/info_icon_size"
                    android:layout_height="@dimen/info_icon_size"
                    android:src="@drawable/ic_info_standard"
                    android:layout_marginEnd="6.0dip"
                    app:tint="?android:textColorSecondary"
                    style="@style/Widget.App.InfoIcon" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="11.0sp"
                    android:textColor="?android:textColorSecondary"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_reconnect_triggers_note"
                    android:layout_weight="1.0" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>