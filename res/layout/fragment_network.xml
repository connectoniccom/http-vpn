<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_surface"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:clipToOutline="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_dialog_header"
        android:layout_width="fill_parent"
        android:layout_height="?actionBarSize"
        android:elevation="0.0dip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@id/fullscreen_dialog_close"
                android:background="?selectableItemBackgroundBorderless"
                android:padding="11.0dip"
                android:visibility="gone"
                android:layout_width="42.0dip"
                android:layout_height="fill_parent"
                android:src="@drawable/ic_close2"
                android:layout_centerVertical="true"
                android:contentDescription="@string/cr_cancel"
                app:tint="?colorAccent" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="18.0sp"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:id="@id/dialog_selection_count"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:text="0"
                android:maxLines="2"
                android:layout_toStartOf="@id/select_all"
                android:layout_toEndOf="@id/fullscreen_dialog_close" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="18.0sp"
                android:typeface="sans"
                android:textStyle="bold"
                android:ellipsize="end"
                android:id="@id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_custom_network"
                android:maxLines="2"
                android:layout_centerVertical="true"
                android:layout_alignWithParentIfMissing="true"
                android:layout_marginStart="18.0dip"
                android:layout_toStartOf="@id/create"
                android:layout_toEndOf="@id/fullscreen_dialog_close" />
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@id/create"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="44.0dip"
                android:layout_height="fill_parent"
                android:layout_centerVertical="true"
                android:contentDescription="@string/ui_create"
                android:layout_marginEnd="6.0dip"
                android:layout_alignParentEnd="true">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/btn_create"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="22.0dip"
                    android:layout_height="22.0dip"
                    android:contentDescription="@string/ui_create"
                    app:srcCompat="@drawable/ic_add"
                    app:tint="?colorAccent" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="10.0sp"
                    android:id="@id/tv_create"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_create" />
            </LinearLayout>
            <ImageView
                android:id="@id/add"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:src="@android:drawable/ic_input_add"
                android:layout_centerVertical="true"
                android:contentDescription="@string/app_name"
                android:layout_marginEnd="10.0dip"
                android:layout_alignParentEnd="true"
                app:tint="@color/colorSuccess" />
            <ImageView
                android:id="@id/delete"
                android:background="@drawable/bg_icon_button_soft"
                android:padding="8.0dip"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="38.0dip"
                android:layout_height="38.0dip"
                android:src="@drawable/ic_del"
                android:layout_centerVertical="true"
                android:contentDescription="@string/ui_remove"
                android:layout_marginEnd="4.0dip"
                android:layout_alignParentEnd="true"
                app:tint="?colorAccent" />
            <ImageView
                android:id="@id/select_all"
                android:background="@drawable/bg_icon_button_soft"
                android:padding="10.0dip"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="38.0dip"
                android:layout_height="38.0dip"
                android:src="@drawable/ic_configs_select_all"
                android:layout_centerVertical="true"
                android:contentDescription="@string/ui_select_all"
                android:layout_marginEnd="3.0dip"
                android:layout_toStartOf="@id/delete"
                app:tint="?colorAccent" />
            <ImageView
                android:id="@id/share"
                android:background="@drawable/bg_icon_button_soft"
                android:padding="8.0dip"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="38.0dip"
                android:layout_height="38.0dip"
                android:src="@drawable/ic_share"
                android:layout_centerVertical="true"
                android:contentDescription="@string/ui_export"
                android:layout_marginEnd="3.0dip"
                android:layout_toStartOf="@id/delete"
                app:tint="?colorAccent" />
        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/show_all_container"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7.0dip"
        android:minHeight="48.0dip"
        android:paddingStart="12.0dip"
        android:paddingEnd="12.0dip"
        android:layout_marginStart="12.0dip"
        android:layout_marginEnd="12.0dip">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="13.0sp"
            android:textStyle="bold"
            android:id="@id/tv_show_all"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/ui_show_all"
            android:layout_weight="1.0"
            android:labelFor="@id/show_all_toggle" />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@id/show_all_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48.0dip"
            android:contentDescription="@string/ui_show_all" />
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/tabSelection"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10.0dip">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:typeface="sans"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@id/tvLeft"
                android:padding="10.0dip"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="@string/ui_recommended"
                android:layout_weight="1.0"
                android:layout_marginStart="10.0dip" />
            <androidx.appcompat.widget.AppCompatTextView
                android:typeface="sans"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@id/tvRight"
                android:padding="10.0dip"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="@string/ui_all_tweaks"
                android:layout_weight="1.0"
                android:layout_marginEnd="10.0dip" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.SearchView
                android:id="@id/svNetwork"
                android:layout_width="fill_parent"
                android:layout_height="48.0dip"
                android:layout_marginStart="12.0dip"
                android:layout_marginEnd="12.0dip"
                app:iconifiedByDefault="false"
                app:queryHint="Search here ..." />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:paddingBottom="10.0dip"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_marginTop="8.0dip"
        android:layout_marginBottom="8.0dip"
        android:layout_weight="1.0">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@id/config_listview"
            android:paddingBottom="6.0dip"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12.0sp"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/empty_state_label"
            android:padding="24.0dip"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:text="@string/ui_no_available_items" />
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:id="@id/resource_empty_state"
            android:padding="24.0dip"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/resource_empty_icon"
                android:layout_width="28.0dip"
                android:layout_height="28.0dip"
                android:alpha="0.65"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_resource_empty_search" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="15.0sp"
                android:gravity="center"
                android:id="@id/resource_empty_title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip"
                android:fontFamily="sans-serif-medium" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="13.0sp"
                android:gravity="center"
                android:id="@id/resource_empty_detail"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip"
                android:text="@string/resource_empty_search_hint"
                android:alpha="0.65" />
        </LinearLayout>
    </FrameLayout>
    <View
        android:id="@id/adapter_legend_divider"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="1.0dip"
        android:layout_marginStart="12.0dip"
        android:layout_marginEnd="12.0dip" />
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@id/adapter_legend_row"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip"
        android:layout_marginBottom="12.0dip"
        android:layout_marginStart="12.0dip"
        android:layout_marginEnd="12.0dip">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@id/legend_icon_shared"
            android:layout_width="14.0dip"
            android:layout_height="14.0dip"
            android:src="@drawable/ic_shared" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="11.0sp"
            android:layout_gravity="center_vertical"
            android:id="@id/legend_label_shared"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_shared"
            android:layout_marginStart="4.0dip" />
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@id/legend_icon_custom"
            android:layout_width="14.0dip"
            android:layout_height="14.0dip"
            android:src="@drawable/ic_cog"
            android:layout_marginStart="16.0dip" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="11.0sp"
            android:layout_gravity="center_vertical"
            android:id="@id/legend_label_custom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_custom"
            android:layout_marginStart="4.0dip" />
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@id/legend_icon_internal"
            android:layout_width="14.0dip"
            android:layout_height="14.0dip"
            android:src="@drawable/ic_enter"
            android:layout_marginStart="16.0dip" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="11.0sp"
            android:layout_gravity="center_vertical"
            android:id="@id/legend_label_internal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/server_source_built_in"
            android:layout_marginStart="4.0dip" />
    </LinearLayout>
</LinearLayout>