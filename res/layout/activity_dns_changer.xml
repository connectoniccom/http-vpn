<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/mainBg"
    android:fitsSystemWindows="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@id/tool_bar"
        layout="@layout/tool_bar" />
    <androidx.core.widget.NestedScrollView
        android:id="@id/dns_changer_scroll"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tool_bar">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="16.0dip"
            android:paddingBottom="24.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16.0dip"
            android:paddingEnd="16.0dip">
            <androidx.cardview.widget.CardView
                android:id="@id/card_dns_status"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12.0dip"
                app:cardElevation="2.0dip">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="92.0dip">
                    <FrameLayout
                        android:id="@id/dns_status_icon_bg"
                        android:layout_width="48.0dip"
                        android:layout_height="48.0dip"
                        android:layout_marginEnd="14.0dip">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_gravity="center"
                            android:id="@id/dns_status_icon"
                            android:layout_width="24.0dip"
                            android:layout_height="24.0dip"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_dns_changer" />
                    </FrameLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="17.0sp"
                            android:typeface="sans"
                            android:textStyle="bold"
                            android:id="@id/tv_dns_status"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/dns_changer_status_ready" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="13.0sp"
                            android:id="@id/tv_dns_status_detail"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4.0dip"
                            android:text="@string/dns_changer_status_ready_detail"
                            android:alpha="0.72" />
                    </LinearLayout>
                    <ProgressBar
                        android:id="@id/progress_dns_status"
                        android:visibility="gone"
                        android:layout_width="26.0dip"
                        android:layout_height="26.0dip"
                        android:indeterminate="true"
                        android:layout_marginStart="10.0dip" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="13.0sp"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14.0dip"
                android:text="@string/dns_changer_subtitle"
                android:layout_marginStart="2.0dip" />
            <androidx.cardview.widget.CardView
                android:id="@id/card_dns_configuration"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14.0dip"
                app:cardCornerRadius="12.0dip"
                app:cardElevation="2.0dip">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@id/dns_provider_container"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12.0sp"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dns_changer_provider_label"
                            android:alpha="0.72" />
                        <androidx.appcompat.widget.AppCompatSpinner
                            android:id="@id/spinner_dns_provider"
                            android:background="@drawable/bg_network_tool_spinner"
                            android:layout_width="fill_parent"
                            android:layout_height="48.0dip"
                            android:layout_marginTop="4.0dip"
                            android:paddingStart="12.0dip"
                            android:paddingEnd="12.0dip" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12.0sp"
                            android:id="@id/tv_dns_provider_description"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7.0dip"
                            android:alpha="0.7"
                            android:layout_marginStart="4.0dip"
                            android:layout_marginEnd="4.0dip" />
                    </LinearLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@id/til_primary_dns"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14.0dip"
                        android:hint="@string/dns_changer_primary_label"
                        style="@style/Widget.App.TextInputLayout">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@id/et_primary_dns"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:inputType="textVisiblePassword|textNoSuggestions"
                            android:imeOptions="actionNext"
                            android:fontFamily="monospace" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@id/til_secondary_dns"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10.0dip"
                        android:hint="@string/dns_changer_secondary_label"
                        style="@style/Widget.App.TextInputLayout">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@id/et_secondary_dns"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:inputType="textVisiblePassword|textNoSuggestions"
                            android:imeOptions="actionDone"
                            android:fontFamily="monospace" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <com.google.android.material.button.MaterialButton
                android:textSize="14.0sp"
                android:typeface="sans"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:id="@id/btn_dns_toggle"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14.0dip"
                android:minHeight="40.0dip"
                android:text="@string/dns_changer_connect"
                android:insetTop="0.0dip"
                android:insetBottom="0.0dip"
                app:backgroundTint="?colorAccent"
                app:cornerRadius="20.0dip" />
            <androidx.cardview.widget.CardView
                android:id="@id/card_dns_information"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14.0dip"
                app:cardCornerRadius="12.0dip"
                app:cardElevation="2.0dip">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/info_icon_size"
                            android:layout_height="@dimen/info_icon_size"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:layout_marginEnd="9.0dip"
                            app:srcCompat="@drawable/ic_info_standard"
                            app:tint="?android:textColorSecondary"
                            style="@style/Widget.App.InfoIcon" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="15.0sp"
                            android:typeface="sans"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dns_changer_how_it_works" />
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="13.0sp"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10.0dip"
                        android:text="@string/dns_changer_how_it_works_detail"
                        android:alpha="0.78" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="13.0sp"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10.0dip"
                        android:text="@string/dns_changer_vpn_exclusion_notice"
                        android:alpha="0.78" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12.0sp"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10.0dip"
                        android:text="@string/dns_changer_transport_notice"
                        android:alpha="0.72" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12.0sp"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10.0dip"
                        android:text="@string/dns_changer_private_dns_notice"
                        android:alpha="0.66" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>