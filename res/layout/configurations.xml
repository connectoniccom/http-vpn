<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:background="@android:color/transparent"
        android:layout_width="fill_parent"
        android:layout_height="?actionBarSize">
        <RelativeLayout
            android:id="@id/rl_top_bar_configs"
            android:background="@android:color/transparent"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/left_section_configs"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12.0dip"
                android:layout_toStartOf="@id/configs_reorder_container"
                android:layout_alignParentStart="true">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="19.0sp"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:id="@id/tv_configs_title"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_configs"
                    android:maxLines="2"
                    android:layout_weight="1.0" />
            </LinearLayout>
            <RelativeLayout
                android:id="@id/configs_reorder_container"
                android:background="@drawable/bg_icon_button_soft"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="38.0dip"
                android:layout_height="38.0dip"
                android:layout_centerVertical="true"
                android:contentDescription="@string/ui_reorder_configurations"
                android:layout_marginEnd="84.0dip"
                android:layout_alignParentEnd="true">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/configs_reorder"
                    android:layout_width="22.0dip"
                    android:layout_height="22.0dip"
                    android:layout_centerInParent="true"
                    android:contentDescription="@string/ui_reorder_configurations"
                    app:srcCompat="@drawable/ic_configs_reorder"
                    app:tint="?colorAccent" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@id/configs_add_container"
                android:background="@drawable/bg_icon_button_soft"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="38.0dip"
                android:layout_height="38.0dip"
                android:layout_centerVertical="true"
                android:contentDescription="@string/ui_add_configuration"
                android:layout_marginEnd="44.0dip"
                android:layout_alignParentEnd="true">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/configs_add"
                    android:layout_width="20.0dip"
                    android:layout_height="20.0dip"
                    android:layout_centerInParent="true"
                    android:contentDescription="@string/ui_add_configuration"
                    app:srcCompat="@drawable/ic_add"
                    app:tint="?colorAccent" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@id/configs_more_container"
                android:background="@drawable/bg_icon_button_soft"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="38.0dip"
                android:layout_height="38.0dip"
                android:layout_centerVertical="true"
                android:contentDescription="@string/ui_config_actions"
                android:layout_marginEnd="4.0dip"
                android:layout_alignParentEnd="true">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/configs_more"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:layout_centerInParent="true"
                    android:contentDescription="@string/ui_config_actions"
                    app:srcCompat="@drawable/menu_dot"
                    app:tint="?colorAccent" />
            </RelativeLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@id/configs_selection_toolbar"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/configs_selection_close"
                android:background="?selectableItemBackgroundBorderless"
                android:padding="11.0dip"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="42.0dip"
                android:layout_height="fill_parent"
                android:contentDescription="@string/cr_cancel"
                android:layout_alignParentStart="true"
                app:srcCompat="@drawable/ic_close2"
                app:tint="?colorAccent" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="18.0sp"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:id="@id/configs_selection_count"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:text="0"
                android:maxLines="1"
                android:layout_toStartOf="@id/configs_selection_toggle"
                android:layout_toEndOf="@id/configs_selection_close" />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/configs_selection_toggle"
                android:background="@drawable/bg_icon_button_soft"
                android:padding="10.0dip"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="38.0dip"
                android:layout_height="38.0dip"
                android:layout_centerVertical="true"
                android:contentDescription="@string/ui_select_all"
                android:layout_marginEnd="3.0dip"
                android:layout_toStartOf="@id/configs_selection_export"
                app:srcCompat="@drawable/ic_configs_select_all"
                app:tint="?colorAccent" />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/configs_selection_export"
                android:background="@drawable/bg_icon_button_soft"
                android:padding="8.0dip"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="38.0dip"
                android:layout_height="38.0dip"
                android:layout_centerVertical="true"
                android:contentDescription="@string/ui_export"
                android:layout_marginEnd="3.0dip"
                android:layout_toStartOf="@id/configs_selection_delete"
                app:srcCompat="@drawable/ic_share"
                app:tint="?colorAccent" />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/configs_selection_delete"
                android:background="@drawable/bg_icon_button_soft"
                android:padding="8.0dip"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="38.0dip"
                android:layout_height="38.0dip"
                android:layout_centerVertical="true"
                android:contentDescription="@string/ui_remove"
                android:layout_marginEnd="4.0dip"
                android:layout_alignParentEnd="true"
                app:srcCompat="@drawable/ic_del"
                app:tint="?colorAccent" />
        </RelativeLayout>
    </FrameLayout>
    <androidx.appcompat.widget.SearchView
        android:id="@id/configs_search"
        android:layout_width="fill_parent"
        android:layout_height="44.0dip"
        android:layout_marginTop="6.0dip"
        android:layout_marginBottom="6.0dip"
        android:iconifiedByDefault="false"
        android:queryHint="@string/ui_search_config_name_or_key"
        android:layout_marginStart="12.0dip"
        android:layout_marginEnd="12.0dip" />
    <FrameLayout
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@id/configs_list"
            android:paddingTop="2.0dip"
            android:paddingBottom="16.0dip"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@id/configs_empty_state"
            android:padding="28.0dip"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/configs_empty_icon"
                android:layout_width="52.0dip"
                android:layout_height="52.0dip"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_nav_configs"
                app:tint="?colorAccent" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16.0sp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@id/configs_empty_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14.0dip"
                android:text="@string/ui_no_available_configurations" />
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@id/configs_empty_add"
                android:background="@drawable/bg_icon_button_soft"
                android:padding="12.0dip"
                android:layout_width="48.0dip"
                android:layout_height="48.0dip"
                android:layout_marginTop="18.0dip"
                android:src="@drawable/ic_add"
                android:scaleType="center"
                android:contentDescription="@string/ui_add_configuration"
                app:tint="?colorAccent" />
        </LinearLayout>
    </FrameLayout>
</androidx.appcompat.widget.LinearLayoutCompat>