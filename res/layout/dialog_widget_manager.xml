<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_surface"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_dialog_header"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="?actionBarSize"
        android:paddingStart="16.0dip"
        android:paddingEnd="8.0dip">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="18.0sp"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/widget_manager_title"
            android:layout_weight="1.0" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@id/btn_widget_manager_close"
            android:text="@string/widget_manager_close"
            style="@style/DialogActionButton.Tonal" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:padding="12.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="13.0sp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12.0dip"
            android:text="@string/widget_manager_message" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/spinner_bg_new"
            android:padding="12.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8.0dip"
            android:minHeight="72.0dip">
            <androidx.appcompat.widget.AppCompatImageView
                android:padding="3.0dip"
                android:layout_width="32.0dip"
                android:layout_height="32.0dip"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_widget_power_on" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:layout_marginStart="12.0dip">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="15.0sp"
                    android:textStyle="bold"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_quick_toggle_title"
                    android:fontFamily="@string/font_family_sans_serif_medium" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12.0sp"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.0dip"
                    android:text="@string/widget_quick_toggle_summary" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/btn_add_quick_toggle_widget"
                android:tag="dab_primary"
                android:background="@drawable/bg_dialog_btn_primary"
                android:padding="6.0dip"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="28.0dip"
                android:layout_height="28.0dip"
                android:scaleType="centerInside"
                android:contentDescription="@string/widget_add_quick_toggle"
                android:layout_marginStart="8.0dip"
                app:srcCompat="@drawable/ic_widget_add" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/spinner_bg_new"
            android:padding="12.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="72.0dip">
            <androidx.appcompat.widget.AppCompatImageView
                android:padding="3.0dip"
                android:layout_width="32.0dip"
                android:layout_height="32.0dip"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_favorite"
                app:tint="#ffff3b30" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:layout_marginStart="12.0dip">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="15.0sp"
                    android:textStyle="bold"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_favorites_title"
                    android:fontFamily="@string/font_family_sans_serif_medium" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12.0sp"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.0dip"
                    android:text="@string/widget_favorites_summary" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/btn_add_favorites_widget"
                android:tag="dab_primary"
                android:background="@drawable/bg_dialog_btn_primary"
                android:padding="6.0dip"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="28.0dip"
                android:layout_height="28.0dip"
                android:scaleType="centerInside"
                android:contentDescription="@string/widget_add_favorites"
                android:layout_marginStart="8.0dip"
                app:srcCompat="@drawable/ic_widget_add" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12.0sp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12.0dip"
            android:text="@string/widget_manager_fallback"
            android:alpha="0.75" />
    </LinearLayout>
</androidx.appcompat.widget.LinearLayoutCompat>