<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:orientation="vertical"
    android:id="@id/mainBg"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@id/tool_bar"
        layout="@layout/tool_bar" />
    <ScrollView
        android:id="@id/logs_scroll_container"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tool_bar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/input_layout"
                android:paddingLeft="16.0dip"
                android:paddingTop="16.0dip"
                android:paddingRight="16.0dip"
                android:paddingBottom="0.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16.0dip">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false">
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@id/et_url_layout"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:hint="@string/ui_host_e_g_google_com_facebook_com"
                        android:layout_weight="1.0"
                        style="@style/Widget.App.TextInputLayout">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@id/et_url"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <androidx.appcompat.widget.AppCompatSpinner
                        android:layout_gravity="center_vertical"
                        android:id="@id/sp_method"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8.0dip" />
                </LinearLayout>
                <GridLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.0dip"
                    android:rowCount="2"
                    android:columnCount="3"
                    android:useDefaultMargins="false"
                    android:alignmentMode="alignMargins">
                    <androidx.appcompat.widget.AppCompatCheckBox
                        android:gravity="center_vertical"
                        android:layout_gravity="fill_horizontal|center"
                        android:id="@id/cb_proxy"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:minWidth="0.0dip"
                        android:minHeight="34.0dip"
                        android:layout_column="0"
                        android:text="@string/proxy"
                        android:layout_row="0"
                        android:layout_columnWeight="1.0" />
                    <androidx.appcompat.widget.AppCompatCheckBox
                        android:gravity="center_vertical"
                        android:layout_gravity="fill_horizontal|center"
                        android:id="@id/cb_ip_info"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:minWidth="0.0dip"
                        android:minHeight="34.0dip"
                        android:layout_column="1"
                        android:text="@string/ui_ip_address"
                        android:layout_row="0"
                        android:layout_columnWeight="1.0" />
                    <androidx.appcompat.widget.AppCompatCheckBox
                        android:gravity="center_vertical"
                        android:layout_gravity="fill_horizontal|center"
                        android:id="@id/cb_cdn_finder"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:minWidth="0.0dip"
                        android:minHeight="34.0dip"
                        android:layout_column="2"
                        android:text="@string/ui_cdn_finder"
                        android:layout_row="0"
                        android:layout_columnWeight="1.0" />
                    <androidx.appcompat.widget.AppCompatCheckBox
                        android:gravity="center_vertical"
                        android:layout_gravity="fill_horizontal|center"
                        android:id="@id/cb_header"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:minWidth="0.0dip"
                        android:minHeight="34.0dip"
                        android:layout_column="0"
                        android:text="@string/ui_custom_header"
                        android:layout_row="1"
                        android:layout_columnWeight="1.0" />
                    <androidx.appcompat.widget.AppCompatCheckBox
                        android:gravity="center_vertical"
                        android:layout_gravity="fill_horizontal|center"
                        android:id="@id/cb_sni_info"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:minWidth="0.0dip"
                        android:minHeight="34.0dip"
                        android:layout_column="1"
                        android:text="@string/ui_sni_info"
                        android:layout_row="1"
                        android:layout_columnWeight="1.0" />
                </GridLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@id/et_proxy_layout"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5.0dip"
                    android:hint="@string/ui_proxy_host_port"
                    style="@style/Widget.App.TextInputLayout">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@id/et_proxy"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@id/et_custom_header_layout"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5.0dip"
                    android:hint="@string/ui_custom_header_optional"
                    app:placeholderText="X-Custom-Header: value"
                    style="@style/Widget.App.TextInputLayout">
                    <com.google.android.material.textfield.TextInputEditText
                        android:gravity="start|center|top"
                        android:id="@id/et_custom_header"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="4"
                        android:minLines="1"
                        android:scrollHorizontally="false"
                        android:inputType="textMultiLine|textNoSuggestions" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton
                    android:textSize="14.0sp"
                    android:typeface="sans"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:id="@id/btn_check"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12.0dip"
                    android:layout_marginBottom="8.0dip"
                    android:minHeight="40.0dip"
                    android:text="@string/ui_check"
                    android:insetTop="0.0dip"
                    android:insetBottom="0.0dip"
                    app:backgroundTint="?colorAccent"
                    app:cornerRadius="20.0dip" />
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/layout_logs"
                android:paddingLeft="16.0dip"
                android:paddingTop="4.0dip"
                android:paddingRight="16.0dip"
                android:paddingBottom="16.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16.0dip" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>