<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/mainBg"
    android:fitsSystemWindows="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@id/tool_bar"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        app:elevation="0.0dip"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@id/toolbar"
            android:background="@color/colorPrimary"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="?actionBarSize"
            app:elevation="0.0dip"
            app:popupTheme="@style/ToolbarSearchTheme"
            app:subtitleTextColor="@color/white"
            app:theme="@style/ToolbarSearchTheme"
            app:titleTextColor="@color/white" />
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@id/settings_scroll"
        android:scrollbars="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tool_bar">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="16.0dip"
            android:paddingBottom="0.0dip"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16.0dip"
            android:paddingEnd="16.0dip">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14.0sp"
                android:gravity="center"
                android:id="@id/settings_no_results"
                android:paddingTop="40.0dip"
                android:paddingBottom="40.0dip"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_no_results" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="13.0sp"
                android:textStyle="bold"
                android:id="@id/label_app_settings"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8.0dip"
                android:text="@string/settings_app_section"
                android:layout_marginStart="4.0dip" />
            <androidx.cardview.widget.CardView
                android:id="@id/card_app_settings"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12.0dip"
                app:cardElevation="2.0dip">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/container_app_settings"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content" />
            </androidx.cardview.widget.CardView>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="13.0sp"
                android:textStyle="bold"
                android:id="@id/label_tunnel_settings"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20.0dip"
                android:layout_marginBottom="8.0dip"
                android:text="@string/settings_tunnel_section"
                android:layout_marginStart="4.0dip" />
            <androidx.cardview.widget.CardView
                android:id="@id/card_tunnel_settings"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12.0dip"
                app:cardElevation="2.0dip">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/container_tunnel_settings"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content" />
            </androidx.cardview.widget.CardView>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="13.0sp"
                android:textStyle="bold"
                android:id="@id/label_port_settings"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20.0dip"
                android:layout_marginBottom="8.0dip"
                android:text="@string/settings_ports_section"
                android:layout_marginStart="4.0dip" />
            <androidx.cardview.widget.CardView
                android:id="@id/card_port_settings"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12.0dip"
                app:cardCornerRadius="12.0dip"
                app:cardElevation="2.0dip">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/container_port_settings"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>