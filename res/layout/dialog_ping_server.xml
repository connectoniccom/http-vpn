<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_surface"
    android:padding="0.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:clipToOutline="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/tv_title"
        android:background="@drawable/bg_dialog_header"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="?actionBarSize"
        android:paddingStart="16.0dip"
        android:paddingEnd="8.0dip">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="18.0sp"
            android:id="@id/title"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/export_tweak"
            android:layout_weight="1.0" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@id/btn_reset"
            android:text="@string/reset"
            style="@style/DialogActionButton.Tonal" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@id/btn_save"
            android:text="@string/file_dialog_create"
            style="@style/DialogActionButton.Primary" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16.0dip"
            android:paddingEnd="16.0dip">
            <androidx.appcompat.widget.SwitchCompat
                android:textStyle="bold"
                android:id="@id/switch_auto_ping"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12.0dip"
                android:layout_marginBottom="8.0dip"
                android:text="@string/auto_ping_enable" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0.0dip">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@id/til_ping_server"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10.0dip"
                    android:hint="@string/ping_url"
                    style="@style/Widget.App.TextInputLayout">
                    <com.google.android.material.textfield.TextInputEditText
                        android:textSize="12.0sp"
                        android:id="@id/et_ping_server"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@id/til_ping_interval"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10.0dip"
                    android:hint="@string/ui_interval_seconds"
                    style="@style/Widget.App.TextInputLayout">
                    <com.google.android.material.textfield.TextInputEditText
                        android:textSize="12.0sp"
                        android:id="@id/et_ping_interval"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:maxLength="4"
                        android:digits="\ 0123456789"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@id/til_ping_timeout"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10.0dip"
                    android:hint="@string/ping_timeout_seconds"
                    style="@style/Widget.App.TextInputLayout">
                    <com.google.android.material.textfield.TextInputEditText
                        android:textSize="12.0sp"
                        android:id="@id/et_ping_timeout"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:maxLength="2"
                        android:digits="\ 0123456789"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@id/btn_toggle_ping_advanced"
                    android:layout_marginBottom="8.0dip"
                    android:text="@string/auto_ping_advanced_show"
                    style="@style/CompactPill.Expandable" />
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/ping_advanced_container"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10.0dip">
                    <androidx.appcompat.widget.SwitchCompat
                        android:textStyle="bold"
                        android:id="@id/switch_ping_failure_recovery"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8.0dip"
                        android:text="@string/auto_ping_failure_recovery" />
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@id/til_ping_failure_threshold"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/auto_ping_failure_threshold"
                            style="@style/Widget.App.TextInputLayout">
                            <com.google.android.material.textfield.TextInputEditText
                                android:textSize="12.0sp"
                                android:id="@id/et_ping_failure_threshold"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:maxLength="2"
                                android:digits="\ 0123456789"
                                android:inputType="number" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@id/til_ping_reconnect_delay"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10.0dip"
                            android:hint="@string/auto_ping_reconnect_delay"
                            style="@style/Widget.App.TextInputLayout">
                            <com.google.android.material.textfield.TextInputEditText
                                android:textSize="12.0sp"
                                android:id="@id/et_ping_reconnect_delay"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:maxLength="3"
                                android:digits="\ 0123456789"
                                android:inputType="number" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textStyle="bold"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8.0dip"
                        android:text="@string/auto_ping_recovery_action" />
                    <RadioGroup
                        android:orientation="vertical"
                        android:id="@id/rg_ping_recovery_action"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <androidx.appcompat.widget.AppCompatRadioButton
                            android:id="@id/rb_ping_reconnect_vpn"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_ping_action_reconnect" />
                        <androidx.appcompat.widget.AppCompatRadioButton
                            android:id="@id/rb_ping_refresh_network"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_ping_action_airplane" />
                    </RadioGroup>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@id/ping_target_ip_container"
                        android:visibility="gone"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8.0dip">
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@id/til_ping_target_ip"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/auto_ping_target_ip"
                            style="@style/Widget.App.TextInputLayout">
                            <com.google.android.material.textfield.TextInputEditText
                                android:textSize="12.0sp"
                                android:id="@id/et_ping_target_ip"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="3"
                                android:maxLength="256"
                                android:inputType="textMultiLine" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12.0sp"
                            android:textColor="?android:textColorSecondary"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6.0dip"
                            android:text="@string/ui_ip_match_operator_guide"
                            android:paddingStart="4.0dip"
                            android:paddingEnd="4.0dip" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12.0sp"
                            android:textColor="?android:textColorSecondary"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2.0dip"
                            android:text="@string/ui_ip_match_operator_samples"
                            android:paddingStart="4.0dip"
                            android:paddingEnd="4.0dip" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12.0sp"
                            android:textColor="?android:textColorSecondary"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2.0dip"
                            android:text="@string/auto_ping_target_ip_helper"
                            android:paddingStart="4.0dip"
                            android:paddingEnd="4.0dip" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@id/btn_ping_assistant_settings"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6.0dip"
                        android:text="@string/auto_ping_configure_assistant"
                        app:cornerRadius="20.0dip"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.button.MaterialButton
                        android:id="@id/btn_clear_ping"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_clear_log"
                        android:layout_weight="1.0"
                        android:layout_marginEnd="6.0dip"
                        app:cornerRadius="20.0dip"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@id/btn_test_ping"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_test_ping"
                        android:layout_weight="1.0"
                        android:layout_marginStart="6.0dip" />
                </LinearLayout>
                <ScrollView
                    android:id="@id/ping_test_log_scroll"
                    android:background="@drawable/bg_dialog_surface"
                    android:layout_width="fill_parent"
                    android:layout_height="120.0dip"
                    android:layout_marginTop="6.0dip"
                    android:fillViewport="true">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@id/ping_test_log"
                        android:padding="8.0dip"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:showDividers="none" />
                </ScrollView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>