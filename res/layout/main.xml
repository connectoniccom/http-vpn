<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    android:orientation="vertical"
    android:id="@id/main_window_bg"
    android:background="@color/windowBackground_light"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@id/drawerLayoutMain"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <androidx.viewpager.widget.ViewPager
                android:id="@id/mPager"
                android:saveEnabled="false"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:layout_weight="1.0"
                android:layoutDirection="ltr">
                <RelativeLayout
                    android:id="@id/layout1"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:textDirection="locale"
                    android:layoutDirection="locale">
                    <include
                        layout="@layout/home" />
                </RelativeLayout>
                <RelativeLayout
                    android:id="@id/layout2"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:textDirection="locale"
                    android:layoutDirection="locale">
                    <include
                        layout="@layout/configurations" />
                </RelativeLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/layout3"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:textDirection="locale"
                    android:layoutDirection="locale">
                    <RelativeLayout
                        android:id="@id/rl_top_bar_logs"
                        android:background="@android:color/transparent"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="?actionBarSize"
                        android:paddingStart="0.0dip"
                        android:paddingEnd="0.0dip">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@id/left_section_logs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="12.0dip"
                            android:layout_toStartOf="@id/btn_share_logs_container"
                            android:layout_alignParentStart="true">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="19.0sp"
                                android:typeface="sans"
                                android:textStyle="bold"
                                android:id="@id/tv_logs_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/log" />
                        </LinearLayout>
                        <RelativeLayout
                            android:id="@id/btn_share_logs_container"
                            android:background="@drawable/bg_icon_button_soft"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_width="38.0dip"
                            android:layout_height="38.0dip"
                            android:layout_centerVertical="true"
                            android:contentDescription="@string/ui_share_logs"
                            android:layout_marginEnd="84.0dip"
                            android:layout_alignParentEnd="true">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@id/btn_share_logs"
                                android:layout_width="21.0dip"
                                android:layout_height="21.0dip"
                                android:layout_centerInParent="true"
                                android:contentDescription="@string/ui_share_logs"
                                app:srcCompat="@drawable/ic_share"
                                app:tint="?colorAccent" />
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@id/btn_copy_logs_container"
                            android:background="@drawable/bg_icon_button_soft"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_width="38.0dip"
                            android:layout_height="38.0dip"
                            android:layout_centerVertical="true"
                            android:contentDescription="@string/ui_copy_logs"
                            android:layout_marginEnd="44.0dip"
                            android:layout_alignParentEnd="true">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@id/btn_copy_logs"
                                android:layout_width="21.0dip"
                                android:layout_height="21.0dip"
                                android:layout_centerInParent="true"
                                android:contentDescription="@string/ui_copy_logs"
                                app:srcCompat="@drawable/ic_copy"
                                app:tint="?colorAccent" />
                        </RelativeLayout>
                        <RelativeLayout
                            android:background="@drawable/bg_icon_button_soft"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_width="38.0dip"
                            android:layout_height="38.0dip"
                            android:layout_centerVertical="true"
                            android:onClick="clearLogs"
                            android:contentDescription="@string/ui_clear_logs"
                            android:layout_marginEnd="4.0dip"
                            android:layout_alignParentEnd="true">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@id/btn_clear_logs"
                                android:layout_width="21.0dip"
                                android:layout_height="21.0dip"
                                android:layout_centerInParent="true"
                                android:contentDescription="@string/ui_clear_logs"
                                app:srcCompat="@drawable/ic_del"
                                app:tint="?colorAccent" />
                        </RelativeLayout>
                    </RelativeLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:layout_gravity="start"
                        android:orientation="horizontal"
                        android:id="@id/log_detail_selector"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4.0dip"
                        android:layout_marginBottom="2.0dip"
                        android:layout_marginStart="12.0dip">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@id/log_detail_basic"
                            android:text="@string/ui_log_level_basic"
                            style="@style/LogDetailPill" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@id/log_detail_detailed"
                            android:text="@string/ui_log_level_detailed"
                            style="@style/LogDetailPill" />
                    </LinearLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@id/lRecyclerView"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:layout_marginTop="8.0dip"
                        android:layout_marginBottom="10.0dip"
                        android:layout_marginStart="10.0dip"
                        android:layout_marginEnd="10.0dip" />
                </LinearLayout>
            </androidx.viewpager.widget.ViewPager>
            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@id/main_bottom_navigation"
                android:background="?colorSurface"
                android:paddingTop="0.0dip"
                android:paddingBottom="0.0dip"
                android:layout_width="fill_parent"
                android:layout_height="52.0dip"
                android:elevation="10.0dip"
                app:itemBackground="@drawable/bottom_navigation_item_background"
                app:itemHorizontalTranslationEnabled="false"
                app:itemIconSize="24.0dip"
                app:itemTextAppearanceActive="@style/TextAppearance.App.BottomNavigation"
                app:itemTextAppearanceInactive="@style/TextAppearance.App.BottomNavigation"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/main_bottom_navigation" />
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_gravity="start"
            android:orientation="vertical"
            android:id="@id/drawer_container"
            android:background="?colorSurface"
            android:layout_width="@dimen/main_drawer_width"
            android:layout_height="fill_parent">
            <com.google.android.material.navigation.NavigationView
                android:id="@id/drawerNavigationView"
                android:background="?colorSurface"
                android:paddingBottom="4.0dip"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:layout_weight="1.0"
                app:headerLayout="@layout/navheader"
                app:itemIconPadding="8.0dip"
                app:itemIconSize="24.0dip"
                app:itemIconTint="@color/black"
                app:itemShapeAppearance="@style/ShapeAppearance.WyrTun.NavigationItem"
                app:itemShapeFillColor="@color/nav_item_fill"
                app:itemShapeInsetEnd="10.0dip"
                app:itemShapeInsetStart="10.0dip"
                app:itemTextAppearance="@style/NavDrawerTextStyle"
                app:menu="@menu/navigation_menu" />
            <com.google.android.material.button.MaterialButton
                android:textSize="14.0sp"
                android:typeface="sans"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@id/nav_update_available"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5.0dip"
                android:layout_marginBottom="10.0dip"
                android:minHeight="40.0dip"
                android:text="@string/ui_update_available"
                android:textAllCaps="false"
                android:layout_marginStart="10.0dip"
                android:layout_marginEnd="10.0dip"
                app:backgroundTint="?colorAccent"
                app:cornerRadius="20.0dip"
                app:icon="@drawable/ic_download_update"
                app:iconGravity="textEnd"
                app:iconPadding="6.0dip"
                app:iconTint="@android:color/white" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="11.0sp"
                android:id="@id/hidden1"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10.0dip"
                android:text="@string/ui_wyrhub" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.drawerlayout.widget.DrawerLayout>
</androidx.appcompat.widget.LinearLayoutCompat>