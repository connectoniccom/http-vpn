<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_surface"
    android:padding="0.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:clipToOutline="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/tv_title"
        android:background="@drawable/bg_dialog_header"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="?actionBarSize"
        android:paddingStart="16.0dip"
        android:paddingEnd="8.0dip">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="18.0sp"
            android:id="@id/title"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/settings_connect_timeout"
            android:layout_weight="1.0" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@id/btn_reset"
            android:text="@string/settings_reset_action"
            style="@style/DialogActionButton.Tonal" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@id/btn_save"
            android:text="@string/settings_save"
            style="@style/DialogActionButton.Primary" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="12.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16.0dip"
        android:paddingEnd="16.0dip">
        <com.google.android.material.textfield.TextInputLayout
            android:id="@id/til_connection_timeout_seconds"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10.0dip"
            android:hint="@string/settings_connection_timeout_input"
            app:helperText="@string/settings_connection_timeout_helper"
            style="@style/Widget.App.TextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                android:textSize="12.0sp"
                android:id="@id/et_connection_timeout_seconds"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:maxLength="5"
                android:digits="\ 0123456789"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</androidx.appcompat.widget.LinearLayoutCompat>