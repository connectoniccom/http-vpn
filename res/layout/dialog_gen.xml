<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_surface"
    android:padding="0.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:clipToOutline="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/tv_title"
        android:background="@drawable/bg_dialog_header"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="?actionBarSize"
        android:paddingStart="16.0dip"
        android:paddingEnd="8.0dip">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="18.0sp"
            android:id="@id/title"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/pay_gen"
            android:layout_weight="1.0" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@id/generate"
            android:text="@string/ui_generate"
            style="@style/DialogActionButton.Primary" />
    </LinearLayout>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ScrollView
            android:id="@id/SSHcrollView"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10.0dip">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent">
                        <com.google.android.material.card.MaterialCardView
                            android:id="@id/preloadedPayloadLayout"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8.0dip"
                            android:layout_marginBottom="8.0dip"
                            app:cardBackgroundColor="@android:color/transparent"
                            app:cardElevation="0.0dip"
                            app:strokeWidth="0.0dip">
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:paddingStart="8.0dip"
                                android:paddingEnd="2.0dip">
                                <androidx.appcompat.widget.AppCompatTextView
                                    android:textSize="14.0sp"
                                    android:textStyle="normal"
                                    android:id="@id/tvPreloadedPayload"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/preloaded_payloads_label"
                                    android:layout_marginEnd="6.0dip" />
                                <HorizontalScrollView
                                    android:paddingTop="4.0dip"
                                    android:paddingBottom="4.0dip"
                                    android:scrollbars="none"
                                    android:clipToPadding="false"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:fillViewport="false"
                                    android:layout_weight="1.0"
                                    android:overScrollMode="never">
                                    <LinearLayout
                                        android:orientation="horizontal"
                                        android:id="@id/cg_preloaded_payloads"
                                        android:paddingTop="0.0dip"
                                        android:paddingBottom="0.0dip"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:paddingStart="0.0dip"
                                        android:paddingEnd="2.0dip">
                                        <androidx.appcompat.widget.AppCompatTextView
                                            android:id="@id/chip_preloaded_websocket_1"
                                            android:text="@string/preloaded_websocket_1"
                                            style="@style/CompactPill.DialogPreset" />
                                        <androidx.appcompat.widget.AppCompatTextView
                                            android:id="@id/chip_preloaded_websocket_2"
                                            android:text="@string/preloaded_websocket_2"
                                            style="@style/CompactPill.DialogPreset" />
                                        <androidx.appcompat.widget.AppCompatTextView
                                            android:id="@id/chip_preloaded_websocket_split_domain"
                                            android:text="@string/preloaded_websocket_split_domain"
                                            style="@style/CompactPill.DialogPreset" />
                                        <androidx.appcompat.widget.AppCompatTextView
                                            android:id="@id/chip_preloaded_websocket_split_ip"
                                            android:text="@string/preloaded_websocket_split_ip"
                                            style="@style/CompactPill.DialogPreset" />
                                        <androidx.appcompat.widget.AppCompatTextView
                                            android:id="@id/chip_preloaded_dual_websocket_domain"
                                            android:text="@string/preloaded_dual_websocket_domain"
                                            style="@style/CompactPill.DialogPreset" />
                                        <androidx.appcompat.widget.AppCompatTextView
                                            android:id="@id/chip_preloaded_dual_websocket_ip"
                                            android:text="@string/preloaded_dual_websocket_ip"
                                            style="@style/CompactPill.DialogPreset" />
                                        <androidx.appcompat.widget.AppCompatTextView
                                            android:id="@id/chip_preloaded_request_tunnel"
                                            android:text="@string/preloaded_request_tunnel"
                                            style="@style/CompactPill.DialogPreset" />
                                    </LinearLayout>
                                </HorizontalScrollView>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                        <RadioGroup
                            android:orientation="horizontal"
                            android:id="@id/radio1"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content">
                            <androidx.appcompat.widget.AppCompatRadioButton
                                android:id="@id/radioMerger"
                                android:layout_width="0.0dip"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="@string/ui_merger"
                                android:layout_weight="1.0" />
                            <androidx.appcompat.widget.AppCompatRadioButton
                                android:id="@id/radioSplit"
                                android:layout_width="0.0dip"
                                android:layout_height="wrap_content"
                                android:text="@string/ui_split"
                                android:layout_weight="1.0" />
                        </RadioGroup>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content">
                            <androidx.appcompat.widget.AppCompatCheckBox
                                android:id="@id/rotationMethodCheckbox"
                                android:layout_width="0.0dip"
                                android:layout_height="wrap_content"
                                android:text="@string/ui_rotation"
                                android:layout_weight="1.0" />
                            <androidx.appcompat.widget.AppCompatCheckBox
                                android:enabled="false"
                                android:id="@id/splitNoDelayCheckbox"
                                android:layout_width="0.0dip"
                                android:layout_height="wrap_content"
                                android:text="@string/ui_split_no_delay"
                                android:layout_weight="1.0" />
                        </LinearLayout>
                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0.0dip"
                            android:layout_marginBottom="10.0dip">
                            <RelativeLayout
                                android:background="@drawable/bg_spin"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6.0dip">
                                <androidx.appcompat.widget.AppCompatEditText
                                    android:gravity="center"
                                    android:id="@id/editTextInjectUrl"
                                    android:background="#00000000"
                                    android:layout_width="fill_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10.0dip"
                                    android:layout_marginBottom="10.0dip"
                                    android:hint="@string/ui_google_com"
                                    android:layout_marginStart="10.0dip"
                                    android:layout_marginEnd="10.0dip" />
                            </RelativeLayout>
                        </RelativeLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textAppearance="?android:textAppearanceSmall"
                                android:textSize="12.0sp"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/ui_request_method"
                                android:layout_weight="1.0"
                                android:layout_marginStart="7.0dip" />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textAppearance="?android:textAppearanceSmall"
                                android:textSize="12.0sp"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/ui_injection_method"
                                android:layout_weight="1.0"
                                android:layout_marginStart="7.0dip" />
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content">
                            <androidx.appcompat.widget.AppCompatSpinner
                                android:entries="@array/request_methods_arrays"
                                android:id="@id/spinnerRequestMethod"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.0"
                                android:layout_below="@id/tvRequestMethod" />
                            <androidx.appcompat.widget.AppCompatSpinner
                                android:entries="@array/inject_methods_arrays"
                                android:id="@id/spinnerInjectMethod"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/ui_injection_method"
                                android:layout_weight="1.0"
                                android:layout_below="@id/tvInjectMethod" />
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@id/queryMethodLayout"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvQueryMethod">
                            <androidx.appcompat.widget.AppCompatCheckBox
                                android:layout_gravity="start"
                                android:id="@id/checkBoxFrontQuery"
                                android:layout_width="0.0dip"
                                android:layout_height="wrap_content"
                                android:text="@string/ui_front_query"
                                android:layout_weight="1.0" />
                            <androidx.appcompat.widget.AppCompatCheckBox
                                android:layout_gravity="end"
                                android:id="@id/checkBoxBackQuery"
                                android:layout_width="0.0dip"
                                android:layout_height="wrap_content"
                                android:text="@string/ui_back_query"
                                android:layout_weight="1.0" />
                        </LinearLayout>
                        <RelativeLayout
                            android:orientation="horizontal"
                            android:id="@id/controlMenuLayout"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvExtra">
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@id/controlMenuLayoutRow1"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content">
                                <androidx.appcompat.widget.AppCompatCheckBox
                                    android:layout_gravity="start"
                                    android:id="@id/checkBoxOnlineHost"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ui_x_online_host"
                                    android:layout_weight="1.0" />
                                <androidx.appcompat.widget.AppCompatCheckBox
                                    android:layout_gravity="end"
                                    android:id="@id/checkBoxForwardHost"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ui_x_forward_host"
                                    android:layout_weight="1.0" />
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@id/controlMenuLayoutRow2"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/controlMenuLayoutRow1">
                                <androidx.appcompat.widget.AppCompatCheckBox
                                    android:layout_gravity="start"
                                    android:id="@id/checkBoxForwardedFor"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ui_x_forwarded_for"
                                    android:layout_weight="1.0" />
                                <androidx.appcompat.widget.AppCompatCheckBox
                                    android:layout_gravity="end"
                                    android:id="@id/checkBoxKeepAlive"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ui_keep_alive"
                                    android:layout_weight="1.0" />
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@id/controlMenuLayoutRow3"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/controlMenuLayoutRow2">
                                <androidx.appcompat.widget.AppCompatCheckBox
                                    android:layout_gravity="start"
                                    android:id="@id/checkBoxUserAgent"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ui_user_agent"
                                    android:layout_weight="1.0" />
                            </LinearLayout>
                        </RelativeLayout>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12.0sp"
                            android:id="@id/tvPayloadSetting"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/payload"
                            android:layout_below="@id/controlMenuLayout"
                            android:layout_marginStart="7.0dip" />
                        <RelativeLayout
                            android:orientation="horizontal"
                            android:id="@id/payloadMenuLayout"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvPayloadSetting">
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@id/payloadMenuLayoutRow1"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content">
                                <androidx.appcompat.widget.AppCompatCheckBox
                                    android:layout_gravity="start"
                                    android:id="@id/checkBoxRealRequest"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ui_real_request"
                                    android:layout_weight="1.0" />
                                <androidx.appcompat.widget.AppCompatCheckBox
                                    android:layout_gravity="end"
                                    android:id="@id/checkBoxDualConnect"
                                    android:layout_width="0.0dip"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ui_dual_connect"
                                    android:layout_weight="1.0" />
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="vertical"
                                android:id="@id/payloadMenuLayoutRow2"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/payloadMenuLayoutRow1">
                                <androidx.appcompat.widget.AppCompatTextView
                                    android:textAppearance="?android:textAppearanceMedium"
                                    android:textSize="12.0sp"
                                    android:layout_width="fill_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10.0dip"
                                    android:text="@string/ui_user_agent"
                                    android:layout_marginStart="7.0dip" />
                                <androidx.appcompat.widget.AppCompatSpinner
                                    android:entries="@array/userAgent"
                                    android:id="@id/spinner2"
                                    android:layout_width="fill_parent"
                                    android:layout_height="wrap_content"
                                    android:minHeight="48.0dip" />
                            </LinearLayout>
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </RelativeLayout>
</androidx.appcompat.widget.LinearLayoutCompat>