<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24.0dip"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="64.0dip"
        android:layout_height="64.0dip"
        android:layout_marginBottom="16.0dip"
        android:src="@drawable/ic_bug_report"
        app:tint="?colorError" />
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="20.0sp"
        android:typeface="sans"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8.0dip"
        android:text="@string/ui_oops_the_app_crashed" />
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24.0dip"
        android:text="@string/ui_we_are_sorry_for_the_inconvenience_please_send_this_error_report_to" />
    <androidx.cardview.widget.CardView
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_marginBottom="24.0dip"
        android:layout_weight="1.0"
        app:cardUseCompatPadding="true">
        <ScrollView
            android:padding="16.0dip"
            android:scrollbars="vertical"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:fillViewport="true">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12.0sp"
                android:textColor="?colorError"
                android:id="@id/crash_log"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textIsSelectable="true"
                android:fontFamily="monospace" />
        </ScrollView>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:weightSum="2.0">
        <com.google.android.material.button.MaterialButton
            android:typeface="sans"
            android:textStyle="bold"
            android:textColor="?colorAccent"
            android:id="@id/btn_copy"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/ui_copy_log"
            android:layout_weight="1.0"
            android:layout_marginEnd="8.0dip"
            app:cornerRadius="20.0dip"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        <com.google.android.material.button.MaterialButton
            android:typeface="sans"
            android:textStyle="bold"
            android:id="@id/btn_restart"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/restart"
            android:layout_weight="1.0"
            android:backgroundTint="?colorAccent" />
    </LinearLayout>
</LinearLayout>