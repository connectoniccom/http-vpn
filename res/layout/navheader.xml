<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:paddingTop="10.0dip"
        android:paddingBottom="0.0dip"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12.0dip"
        android:paddingEnd="12.0dip">
        <RelativeLayout
            android:background="@drawable/bg_app_card"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="74.0dip"
            android:paddingStart="14.0dip"
            android:paddingEnd="14.0dip"
            android:translationZ="1.0dip"
            android:elevation="3.0dip">
            <LinearLayout
                android:gravity="center"
                android:id="@id/ll_logo_account"
                android:background="@drawable/bg_app_card_accent_soft"
                android:layout_width="48.0dip"
                android:layout_height="48.0dip"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:elevation="2.0dip">
                <ImageView
                    android:id="@id/imageView_appLogo"
                    android:layout_width="42.0dip"
                    android:layout_height="42.0dip"
                    android:contentDescription="@string/app_name"
                    app:srcCompat="@mipmap/ic_launcher" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="16.0dip"
                android:layout_toEndOf="@id/ll_logo_account">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="17.0sp"
                        android:typeface="sans"
                        android:textStyle="bold"
                        android:id="@id/navheadertv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="10.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/pro_ink"
                        android:gravity="center"
                        android:id="@id/nav_header_pro_badge"
                        android:background="@drawable/bg_nav_pro_badge"
                        android:paddingTop="2.0dip"
                        android:paddingBottom="2.0dip"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pro_subscription_name"
                        android:paddingStart="8.0dip"
                        android:paddingEnd="8.0dip"
                        android:layout_marginStart="6.0dip" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12.0sp"
                        android:typeface="sans"
                        android:textStyle="bold"
                        android:id="@id/nh_tv_copyright"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_value_2026_a_wyrhub"
                        android:paddingStart="0.0dip"
                        android:paddingEnd="4.0dip" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12.0sp"
                        android:id="@id/user_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_v1_0_0_100"
                        android:paddingStart="0.0dip"
                        android:paddingEnd="4.0dip" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@id/nav_section_tabs"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12.0dip"
            android:minHeight="42.0dip"
            app:checkedButton="@id/nav_tab_main"
            app:selectionRequired="true"
            app:singleSelection="true">
            <com.google.android.material.button.MaterialButton
                android:textSize="13.0sp"
                android:typeface="sans"
                android:textStyle="bold"
                android:id="@id/nav_tab_main"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:minHeight="42.0dip"
                android:text="@string/ui_main"
                android:layout_weight="1.0"
                android:textAllCaps="false"
                app:cornerRadius="13.0dip"
                app:strokeWidth="1.0dip"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
            <com.google.android.material.button.MaterialButton
                android:textSize="13.0sp"
                android:typeface="sans"
                android:textStyle="bold"
                android:id="@id/nav_tab_tools"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:minHeight="42.0dip"
                android:text="@string/global_search_category_tools"
                android:layout_weight="1.0"
                android:textAllCaps="false"
                app:cornerRadius="13.0dip"
                app:strokeWidth="1.0dip"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </androidx.appcompat.widget.LinearLayoutCompat>
</FrameLayout>