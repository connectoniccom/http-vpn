<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_surface"
    android:padding="0.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:clipToOutline="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/tv_title"
        android:background="@drawable/bg_dialog_header"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="?actionBarSize"
        android:paddingStart="16.0dip"
        android:paddingEnd="8.0dip">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="18.0sp"
            android:id="@id/title"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/label_import_config"
            android:layout_weight="1.0" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@id/btn_cancel"
            android:text="@string/cr_cancel"
            style="@style/DialogActionButton.Tonal" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:padding="12.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/btn_paste_config"
            android:background="@drawable/spinner_bg_new"
            android:padding="10.0dip"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8.0dip">
            <ImageView
                android:id="@id/ic_paste_config"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:src="@drawable/ic_clipboard"
                app:tint="?colorOnSurface" />
            <ProgressBar
                android:id="@id/progress_paste_config"
                android:visibility="gone"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:indeterminate="true"
                android:indeterminateTint="?colorOnSurface" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:layout_marginStart="12.0dip">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14.0sp"
                    android:typeface="sans"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_paste_config" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="11.0sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_import_configuration_from_clipboard" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/btn_import_file"
            android:background="@drawable/spinner_bg_new"
            android:padding="10.0dip"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8.0dip">
            <ImageView
                android:id="@id/ic_import_file"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:src="@drawable/ic_config"
                app:tint="?colorOnSurface" />
            <ProgressBar
                android:id="@id/progress_import_file"
                android:visibility="gone"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:indeterminate="true"
                android:indeterminateTint="?colorOnSurface" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:layout_marginStart="12.0dip">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14.0sp"
                    android:typeface="sans"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_import_file" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="11.0sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_import_configuration_from_ht_file" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/btn_import_cloud"
            android:background="@drawable/spinner_bg_new"
            android:padding="10.0dip"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8.0dip">
            <ImageView
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:src="@drawable/ic_cloud_dl"
                app:tint="?colorOnSurface" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:layout_marginStart="12.0dip">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14.0sp"
                    android:typeface="sans"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_import_cloud" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="11.0sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_import_configuration_from_cloud" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/btn_scan_qr"
            android:background="@drawable/spinner_bg_new"
            android:padding="10.0dip"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@id/ic_scan_qr"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:src="@drawable/ic_qr"
                app:tint="?colorOnSurface" />
            <ProgressBar
                android:id="@id/progress_scan_qr"
                android:visibility="gone"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:indeterminate="true"
                android:indeterminateTint="?colorOnSurface" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:layout_marginStart="12.0dip">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14.0sp"
                    android:typeface="sans"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_scan_qr" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="11.0sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_import_configuration_from_qr_code" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12.0dip">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/info_icon_size"
                android:layout_height="@dimen/info_icon_size"
                android:src="@drawable/ic_info_standard"
                android:layout_marginEnd="6.0dip"
                app:tint="?android:textColorSecondary"
                style="@style/Widget.App.InfoIcon" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="11.0sp"
                android:textColor="?android:textColorSecondary"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="@string/ui_config_can_only_be_viewed_and_edited_on_the_device_it_was_89c9e7de"
                android:layout_weight="1.0" />
        </LinearLayout>
    </LinearLayout>
</androidx.appcompat.widget.LinearLayoutCompat>