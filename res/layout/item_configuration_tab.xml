<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@id/config_tab_item_root"
    android:background="@drawable/spinner_bg_new"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4.0dip"
    android:layout_marginBottom="6.0dip"
    android:minHeight="56.0dip"
    android:paddingEnd="8.0dip"
    android:layout_marginStart="12.0dip"
    android:layout_marginEnd="12.0dip"
    android:elevation="2.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:id="@id/config_tab_active_indicator"
        android:visibility="invisible"
        android:layout_width="4.0dip"
        android:layout_height="fill_parent"
        android:layout_marginTop="5.0dip"
        android:layout_marginBottom="5.0dip"
        android:importantForAccessibility="no"
        android:layout_marginStart="1.0dip"
        android:layout_marginEnd="10.0dip" />
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_weight="1.0">
        <LinearLayout
            android:gravity="start|center"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14.0sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:id="@id/config_tab_item_title"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:layout_weight="1.0" />
            <FrameLayout
                android:id="@id/config_tab_item_info"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="20.0dip"
                android:layout_height="20.0dip">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:background="?selectableItemBackgroundBorderless"
                    android:layout_width="@dimen/info_icon_size"
                    android:layout_height="@dimen/info_icon_size"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_info_standard"
                    app:tint="?android:textColorSecondary"
                    style="@style/Widget.App.InfoIcon" />
            </FrameLayout>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="11.0sp"
            android:ellipsize="end"
            android:id="@id/config_tab_item_summary"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1.0dip"
            android:maxLines="2" />
    </LinearLayout>
    <FrameLayout
        android:id="@id/config_tab_item_drag"
        android:background="?selectableItemBackgroundBorderless"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="28.0dip"
        android:layout_height="fill_parent"
        android:contentDescription="@string/ui_reorder_configurations">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|center"
            android:layout_width="24.0dip"
            android:layout_height="24.0dip"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_config_drag_handle"
            app:tint="?android:textColorSecondary" />
    </FrameLayout>
    <FrameLayout
        android:id="@id/config_tab_item_more"
        android:background="?selectableItemBackgroundBorderless"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="28.0dip"
        android:layout_height="fill_parent"
        android:contentDescription="@string/ui_config_actions">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="start|center"
            android:layout_width="24.0dip"
            android:layout_height="24.0dip"
            app:srcCompat="@drawable/ic_config_more"
            app:tint="?android:textColorSecondary" />
    </FrameLayout>
</LinearLayout>