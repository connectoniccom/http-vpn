<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="end"
    android:orientation="vertical"
    android:id="@id/mainColorChooserBG"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/color_bg"
        android:background="?colorAccent"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="?actionBarSize"
            android:paddingStart="16.0dip"
            android:paddingEnd="8.0dip">
            <androidx.appcompat.widget.AppCompatTextView
                android:textAppearance="?android:textAppearanceMedium"
                android:textSize="18.0sp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@id/tvChoose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/global_search_themes"
                android:maxLines="2"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/random_theme"
                android:layout_alignParentStart="true" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@id/random_theme"
                android:text="@string/ui_random"
                android:layout_centerVertical="true"
                android:layout_marginEnd="4.0dip"
                android:layout_toStartOf="@id/reset_theme"
                style="@style/DialogActionButton.HeaderTonal" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@id/reset_theme"
                android:text="@string/reset"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                style="@style/DialogActionButton.HeaderTonal" />
        </RelativeLayout>
        <View
            android:background="?android:dividerVertical"
            android:layout_width="fill_parent"
            android:layout_height="1.0dip" />
    </LinearLayout>
    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_margin="10.0dip">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <RadioGroup
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@id/dialog_tunnel_radio"
                android:visibility="visible"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatRadioButton
                    android:textSize="12.0dip"
                    android:typeface="sans"
                    android:textStyle="bold"
                    android:id="@id/type_light"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/ui_light"
                    android:paddingStart="6.0dip"
                    android:paddingEnd="6.0dip"
                    android:layout_marginEnd="8.0dip" />
                <androidx.appcompat.widget.AppCompatRadioButton
                    android:textSize="12.0dip"
                    android:typeface="sans"
                    android:textStyle="bold"
                    android:id="@id/type_modern"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_modern"
                    android:paddingStart="6.0dip"
                    android:paddingEnd="6.0dip"
                    android:layout_marginEnd="8.0dip" />
                <androidx.appcompat.widget.AppCompatRadioButton
                    android:textSize="12.0dip"
                    android:typeface="sans"
                    android:textStyle="bold"
                    android:id="@id/type_classic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_classic"
                    android:paddingStart="6.0dip"
                    android:paddingEnd="6.0dip" />
            </RadioGroup>
            <org.polaric.md_colorfragment.FillGridView
                android:gravity="center"
                android:orientation="vertical"
                android:id="@id/grid"
                android:padding="16.0dip"
                android:clipToPadding="false"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:horizontalSpacing="8.0dip"
                android:verticalSpacing="8.0dip"
                android:stretchMode="columnWidth"
                android:columnWidth="56.0dip"
                android:numColumns="auto_fit" />
        </LinearLayout>
    </ScrollView>
    <RelativeLayout
        android:gravity="center_vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10.0dip"
        android:layout_marginBottom="10.0dip">
        <LinearLayout
            android:gravity="center"
            android:id="@id/back"
            android:padding="10.0dip"
            android:layout_width="100.0dip"
            android:layout_height="wrap_content"
            android:layout_margin="10.0dip"
            android:layout_marginStart="10.0dip">
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/colorPrimary"
                android:layout_gravity="center"
                android:id="@id/back_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/back"
                android:letterSpacing="0.1" />
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:id="@id/apply"
            android:padding="0.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10.0dip"
            android:minWidth="150.0dip"
            android:minHeight="40.0dip"
            android:layout_alignParentEnd="true"
            app:cardBackgroundColor="@color/colorPrimary"
            app:cardCornerRadius="20.0dip"
            app:cardElevation="3.0dip">
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:id="@id/tvApply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/apply"
                android:layout_alignParentEnd="true"
                android:letterSpacing="0.1" />
        </androidx.cardview.widget.CardView>
    </RelativeLayout>
</LinearLayout>