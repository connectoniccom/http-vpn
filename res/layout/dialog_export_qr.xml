<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_surface"
    android:padding="0.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:clipToOutline="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/tv_title"
        android:background="@drawable/bg_dialog_header"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="?actionBarSize"
        android:paddingStart="16.0dip"
        android:paddingEnd="8.0dip">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="18.0sp"
            android:id="@id/title"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/ui_export_qr_code"
            android:layout_weight="1.0" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@id/btn_close"
            android:text="@string/app_unlicensed_close"
            style="@style/DialogActionButton.Tonal" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:padding="16.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@id/qr_content"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10.0dip">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:id="@id/img_qr"
                    android:background="@android:color/white"
                    android:padding="8.0dip"
                    android:layout_width="240.0dip"
                    android:layout_height="240.0dip"
                    android:contentDescription="@string/ui_config_qr_code" />
            </FrameLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="11.0sp"
                android:textColor="?android:textColorSecondary"
                android:gravity="center"
                android:id="@id/tv_export_help"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14.0dip"
                android:text="@string/ui_the_qr_contains_the_web_share_link" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="11.0sp"
                android:textStyle="bold"
                android:textColor="?android:textColorSecondary"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5.0dip"
                android:text="@string/ui_cloud_import_key" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/spinner_bg_new"
                android:padding="10.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12.0sp"
                    android:ellipsize="end"
                    android:id="@id/tv_raw_key"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:maxLines="4"
                    android:layout_weight="1.0"
                    android:textIsSelectable="true" />
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/btn_copy_raw_key"
                    android:background="?selectableItemBackgroundBorderless"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:src="@drawable/ic_copy"
                    android:contentDescription="@string/ui_copy_cloud_import_key"
                    android:layout_marginStart="8.0dip"
                    app:tint="?colorOnSurface" />
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/btn_share_raw_key"
                    android:background="?selectableItemBackgroundBorderless"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:src="@drawable/ic_share"
                    android:contentDescription="@string/ui_share_cloud_import_key"
                    android:layout_marginStart="8.0dip"
                    app:tint="?colorOnSurface" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/spinner_bg_new"
                android:padding="10.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6.0dip">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12.0sp"
                    android:ellipsize="end"
                    android:id="@id/tv_key"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:maxLines="4"
                    android:layout_weight="1.0"
                    android:textIsSelectable="true" />
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/btn_copy_key"
                    android:background="?selectableItemBackgroundBorderless"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:src="@drawable/ic_copy"
                    android:contentDescription="@string/ui_copy_cloud_import_key"
                    android:layout_marginStart="8.0dip"
                    app:tint="?colorOnSurface" />
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/btn_share_key"
                    android:background="?selectableItemBackgroundBorderless"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:src="@drawable/ic_share"
                    android:contentDescription="@string/ui_share_cloud_import_key"
                    android:layout_marginStart="8.0dip"
                    app:tint="?colorOnSurface" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="11.0sp"
                android:textStyle="bold"
                android:textColor="?android:textColorSecondary"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12.0dip"
                android:layout_marginBottom="5.0dip"
                android:text="@string/ui_web_share_link" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/spinner_bg_new"
                android:padding="10.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12.0sp"
                    android:ellipsize="end"
                    android:id="@id/tv_share_url"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:maxLines="4"
                    android:layout_weight="1.0"
                    android:textIsSelectable="true" />
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/btn_copy_share_url"
                    android:background="?selectableItemBackgroundBorderless"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:src="@drawable/ic_copy"
                    android:contentDescription="@string/ui_copy_web_share_link"
                    android:layout_marginStart="8.0dip"
                    app:tint="?colorOnSurface" />
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/btn_share_share_url"
                    android:background="?selectableItemBackgroundBorderless"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:src="@drawable/ic_share"
                    android:contentDescription="@string/ui_share_web_link"
                    android:layout_marginStart="8.0dip"
                    app:tint="?colorOnSurface" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="11.0sp"
                android:textColor="?android:textColorSecondary"
                android:id="@id/tv_meta"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip" />
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/qr_actions"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14.0dip">
                <com.google.android.material.button.MaterialButton
                    android:id="@id/btn_share_qr"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_share_qr"
                    android:layout_weight="1.0"
                    android:layout_marginEnd="6.0dip"
                    app:cornerRadius="20.0dip"
                    app:icon="@drawable/ic_share"
                    app:iconGravity="textStart"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                <com.google.android.material.button.MaterialButton
                    android:id="@id/btn_save_qr"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_save_qr"
                    android:layout_weight="1.0"
                    android:layout_marginStart="6.0dip"
                    app:icon="@drawable/ic_save"
                    app:iconGravity="textStart" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@id/btn_copy_all"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14.0dip"
                android:text="@string/ui_copy_all"
                app:cornerRadius="20.0dip"
                app:icon="@drawable/ic_copy"
                app:iconGravity="textStart" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>