<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/promo_item_layout"
        android:background="@drawable/spinner_bg_new"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4.0dip"
        android:layout_marginBottom="6.0dip"
        android:minHeight="58.0dip"
        android:paddingStart="0.0dip"
        android:paddingEnd="4.0dip"
        android:layout_marginStart="12.0dip"
        android:layout_marginEnd="12.0dip"
        android:elevation="2.0dip">
        <View
            android:id="@id/item_active_indicator"
            android:visibility="invisible"
            android:layout_width="4.0dip"
            android:layout_height="fill_parent"
            android:layout_marginTop="4.5dip"
            android:layout_marginBottom="4.5dip"
            android:importantForAccessibility="no"
            android:layout_marginStart="1.0dip"
            android:layout_marginEnd="8.0dip" />
        <RelativeLayout
            android:gravity="center"
            android:id="@id/image"
            android:visibility="gone"
            android:layout_width="32.0dip"
            android:layout_height="fill_parent">
            <ImageView
                android:layout_width="20.0dip"
                android:layout_height="20.0dip"
                android:src="@drawable/ic_drag" />
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="0.0dip"
                android:layout_marginEnd="0.0dip">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <LinearLayout
                        android:gravity="start|center"
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_gravity="center_vertical"
                            android:id="@id/server_item_icon"
                            android:visibility="gone"
                            android:layout_width="14.0dip"
                            android:layout_height="14.0dip"
                            android:src="@drawable/ic_shared"
                            android:layout_marginEnd="4.0dip" />
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_gravity="center_vertical"
                            android:id="@id/item_internal"
                            android:visibility="gone"
                            android:layout_width="14.0dip"
                            android:layout_height="14.0dip"
                            android:src="@drawable/ic_enter"
                            android:layout_marginEnd="4.0dip" />
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_gravity="center_vertical"
                            android:id="@id/item_gaming"
                            android:visibility="gone"
                            android:layout_width="14.0dip"
                            android:layout_height="14.0dip"
                            android:src="@drawable/ic_game"
                            android:layout_marginEnd="4.0dip" />
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_gravity="center_vertical"
                            android:id="@id/item_torrent"
                            android:visibility="gone"
                            android:layout_width="14.0dip"
                            android:layout_height="14.0dip"
                            android:src="@drawable/ic_torrent"
                            android:layout_marginEnd="4.0dip" />
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_gravity="center_vertical"
                            android:id="@id/item_custom"
                            android:visibility="gone"
                            android:layout_width="14.0dip"
                            android:layout_height="14.0dip"
                            android:src="@drawable/ic_cog"
                            android:layout_marginEnd="4.0dip" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="14.0sp"
                            android:typeface="sans"
                            android:textStyle="bold"
                            android:ellipsize="end"
                            android:layout_gravity="center_vertical"
                            android:id="@id/server_item_title"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:scrollHorizontally="false"
                            android:singleLine="true"
                            android:layout_weight="1.0" />
                        <FrameLayout
                            android:layout_gravity="center_vertical"
                            android:id="@id/fl_iv_item_info"
                            android:focusable="true"
                            android:visibility="gone"
                            android:clickable="true"
                            android:layout_width="20.0dip"
                            android:layout_height="20.0dip">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_gravity="center"
                                android:background="?selectableItemBackgroundBorderless"
                                android:layout_width="@dimen/info_icon_size"
                                android:layout_height="@dimen/info_icon_size"
                                android:src="@drawable/ic_info_standard"
                                app:tint="?android:textColorSecondary"
                                style="@style/Widget.App.InfoIcon" />
                        </FrameLayout>
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="11.0sp"
                        android:textStyle="normal"
                        android:id="@id/server_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name" />
                </LinearLayout>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </LinearLayout>
        <FrameLayout
            android:id="@id/fl_server_item_edit"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="30.0dip"
            android:layout_height="fill_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@id/server_item_edit"
                android:layout_width="20.0dip"
                android:layout_height="20.0dip"
                app:srcCompat="@drawable/ic_edit" />
        </FrameLayout>
        <FrameLayout
            android:id="@id/fl_server_item_duplicate"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="30.0dip"
            android:layout_height="fill_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@id/server_item_duplicate"
                android:layout_width="20.0dip"
                android:layout_height="20.0dip"
                app:srcCompat="@drawable/ic_copy" />
        </FrameLayout>
        <FrameLayout
            android:id="@id/fl_server_item_remove"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="30.0dip"
            android:layout_height="fill_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@id/server_item_remove"
                android:layout_width="20.0dip"
                android:layout_height="20.0dip"
                app:srcCompat="@drawable/ic_del" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>