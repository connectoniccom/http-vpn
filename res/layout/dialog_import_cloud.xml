<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_surface"
    android:padding="0.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:clipToOutline="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/tv_title"
        android:background="@drawable/bg_dialog_header"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="?actionBarSize"
        android:paddingStart="16.0dip"
        android:paddingEnd="8.0dip">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="18.0sp"
            android:id="@id/title"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/ui_cloud_config"
            android:layout_weight="1.0" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@id/btn_skip"
            android:visibility="gone"
            android:text="@string/ui_skip"
            style="@style/DialogActionButton.Tonal" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@id/btn_save"
            android:text="@string/file_dialog_create"
            style="@style/DialogActionButton.Primary" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="14.0dip"
        android:paddingBottom="5.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16.0dip"
        android:paddingEnd="16.0dip">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0.0dip">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14.0sp"
                android:textStyle="normal"
                android:id="@id/tv_config_name"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8.0dip" />
            <FrameLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@id/til_url_key"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/ui_config_key_url"
                    style="@style/Widget.App.TextInputLayout">
                    <com.google.android.material.textfield.TextInputEditText
                        android:textSize="12.0sp"
                        android:id="@id/txt_url_key"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:scrollHorizontally="true"
                        android:singleLine="true"
                        android:inputType="textVisiblePassword"
                        android:paddingStart="12.0dip"
                        android:paddingEnd="84.0dip"
                        android:autofillHints="@null" />
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="end|center"
                    android:orientation="horizontal"
                    android:layout_width="72.0dip"
                    android:layout_height="48.0dip"
                    android:translationY="2.0dip"
                    android:layout_marginEnd="4.0dip">
                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@id/btn_paste_cloud"
                        android:background="?selectableItemBackgroundBorderless"
                        android:padding="9.0dip"
                        android:layout_width="36.0dip"
                        android:layout_height="48.0dip"
                        android:src="@drawable/ic_clipboard"
                        android:scaleType="center"
                        android:minWidth="0.0dip"
                        android:minHeight="0.0dip"
                        android:contentDescription="@string/ui_paste"
                        app:tint="?colorAccent" />
                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@id/btn_scan_qr_cloud"
                        android:background="?selectableItemBackgroundBorderless"
                        android:padding="9.0dip"
                        android:layout_width="36.0dip"
                        android:layout_height="48.0dip"
                        android:src="@drawable/ic_qr"
                        android:scaleType="center"
                        android:minWidth="0.0dip"
                        android:minHeight="0.0dip"
                        android:contentDescription="@string/ui_scan_qr"
                        app:tint="?colorAccent" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.appcompat.widget.LinearLayoutCompat>