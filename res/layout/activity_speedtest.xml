<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/mainBg"
    android:fitsSystemWindows="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@id/tool_bar"
        layout="@layout/tool_bar" />
    <ScrollView
        android:id="@id/mainContainerBg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tool_bar">
        <LinearLayout
            android:orientation="vertical"
            android:padding="16.0dip"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@id/card_speed"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14.0dip"
                app:cardCornerRadius="12.0dip"
                app:cardElevation="2.0dip">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="18.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:layout_width="230.0dip"
                        android:layout_height="230.0dip">
                        <com.wyrhub.vpn.view.CircleProgressBar
                            android:id="@id/speed_gauge"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            app:max="100"
                            app:min="0"
                            app:progress="0"
                            app:progressBarThickness="10.0dip"
                            app:progressbarColor="@color/colorAccentTheme" />
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="20.0dip"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="12.0sp"
                                android:typeface="sans"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:id="@id/tv_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ui_ready"
                                android:includeFontPadding="false"
                                android:alpha="0.72"
                                android:textAllCaps="true" />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="48.0sp"
                                android:typeface="sans"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:id="@id/tv_primary_speed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10.0dip"
                                android:text="@string/ui_value_0_0"
                                android:includeFontPadding="false" />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="14.0sp"
                                android:gravity="center"
                                android:id="@id/tv_speed_unit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4.0dip"
                                android:text="@string/ui_mbps"
                                android:includeFontPadding="false"
                                android:alpha="0.76" />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="12.0sp"
                                android:gravity="center"
                                android:id="@id/tv_connection_type"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14.0dip"
                                android:text="@string/ui_network"
                                android:includeFontPadding="false"
                                android:alpha="0.72" />
                        </LinearLayout>
                    </FrameLayout>
                    <ProgressBar
                        android:id="@id/progress_test"
                        android:layout_width="fill_parent"
                        android:layout_height="6.0dip"
                        android:layout_marginTop="8.0dip"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/speedtest_progress_rounded"
                        style="?android:progressBarStyleHorizontal" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="13.0sp"
                        android:gravity="center"
                        android:id="@id/tv_quality"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14.0dip"
                        android:text="@string/ui_tap_start_test_to_measure_latency_download_and_upload"
                        android:alpha="0.75" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false">
                <androidx.cardview.widget.CardView
                    android:id="@id/card_latency"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:minHeight="96.0dip"
                    android:layout_weight="1.0"
                    android:layout_marginEnd="5.0dip"
                    app:cardCornerRadius="12.0dip"
                    app:cardElevation="2.0dip">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10.0dip"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12.0sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_latency"
                            android:includeFontPadding="false"
                            android:alpha="0.68" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="22.0sp"
                            android:typeface="sans"
                            android:textStyle="bold"
                            android:id="@id/tv_latency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8.0dip"
                            android:text="@string/ui_text_e6a9fc04"
                            android:includeFontPadding="false" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="11.0sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4.0dip"
                            android:text="@string/ui_ms"
                            android:includeFontPadding="false"
                            android:alpha="0.62" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:id="@id/card_download"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:minHeight="96.0dip"
                    android:layout_weight="1.0"
                    android:layout_marginStart="5.0dip"
                    android:layout_marginEnd="5.0dip"
                    app:cardCornerRadius="12.0dip"
                    app:cardElevation="2.0dip">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10.0dip"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12.0sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/download"
                            android:includeFontPadding="false"
                            android:alpha="0.68" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="22.0sp"
                            android:typeface="sans"
                            android:textStyle="bold"
                            android:id="@id/tv_download"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8.0dip"
                            android:text="@string/ui_text_e6a9fc04"
                            android:includeFontPadding="false" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="11.0sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4.0dip"
                            android:text="@string/ui_mbps"
                            android:includeFontPadding="false"
                            android:alpha="0.62" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:id="@id/card_upload"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:minHeight="96.0dip"
                    android:layout_weight="1.0"
                    android:layout_marginStart="5.0dip"
                    app:cardCornerRadius="12.0dip"
                    app:cardElevation="2.0dip">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10.0dip"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12.0sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/upload"
                            android:includeFontPadding="false"
                            android:alpha="0.68" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="22.0sp"
                            android:typeface="sans"
                            android:textStyle="bold"
                            android:id="@id/tv_upload"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8.0dip"
                            android:text="@string/ui_text_e6a9fc04"
                            android:includeFontPadding="false" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="11.0sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4.0dip"
                            android:text="@string/ui_mbps"
                            android:includeFontPadding="false"
                            android:alpha="0.62" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:textSize="14.0sp"
                android:typeface="sans"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:id="@id/btn_start_test"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14.0dip"
                android:minHeight="40.0dip"
                android:text="@string/ui_start_test"
                android:insetTop="0.0dip"
                android:insetBottom="0.0dip"
                app:backgroundTint="?colorAccent"
                app:cornerRadius="20.0dip" />
            <androidx.cardview.widget.CardView
                android:id="@id/card_logs"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14.0dip"
                android:layout_marginBottom="12.0dip"
                app:cardCornerRadius="12.0dip"
                app:cardElevation="2.0dip">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="14.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16.0sp"
                        android:textStyle="bold"
                        android:textColor="?android:textColorPrimary"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8.0dip"
                        android:text="@string/log" />
                    <TextView
                        android:textSize="13.0sp"
                        android:textColor="?android:textColorSecondary"
                        android:id="@id/speed_logs_empty"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_ready" />
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@id/layout_logs"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>