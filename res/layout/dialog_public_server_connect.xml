<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_surface"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:clipToOutline="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_dialog_header"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="?actionBarSize"
        android:paddingStart="16.0dip"
        android:paddingEnd="8.0dip">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="18.0sp"
                android:ellipsize="end"
                android:id="@id/public_server_dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_add_server"
                android:maxLines="2" />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/info_server_help"
                android:background="?selectableItemBackgroundBorderless"
                android:padding="16.5dip"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="48.0dip"
                android:layout_height="48.0dip"
                android:src="@drawable/ic_info_standard"
                android:scaleType="fitCenter"
                android:contentDescription="@string/server_form_help_title"
                app:tint="?android:textColorSecondary"
                style="@style/Widget.App.InfoIcon" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@id/public_server_cancel"
            android:text="@string/cr_cancel"
            style="@style/DialogActionButton.Tonal" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@id/public_server_add"
            android:text="@string/ui_add"
            style="@style/DialogActionButton.Primary" />
    </LinearLayout>
    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="10.0dip"
            android:paddingBottom="10.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10.0dip"
            android:paddingEnd="10.0dip">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_app_card"
                android:padding="14.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="17.0sp"
                    android:textStyle="bold"
                    android:id="@id/public_server_name"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12.0sp"
                    android:textColor="?android:textColorSecondary"
                    android:id="@id/public_server_metadata"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dip" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="13.0sp"
                    android:id="@id/public_server_description"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10.0dip" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip"
                android:layout_marginBottom="6.0dip">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14.0sp"
                    android:ellipsize="end"
                    android:layout_width="112.0dip"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_configuration"
                    android:maxLines="3" />
                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@id/public_server_config_spinner"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:minHeight="48.0dip"
                    android:layout_weight="1.0"
                    android:spinnerMode="dropdown" />
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@id/public_server_new_config_layout"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6.0dip"
                android:hint="@string/ui_new_configuration_name"
                style="@style/Widget.App.TextInputLayout">
                <com.google.android.material.textfield.TextInputEditText
                    android:textSize="14.0sp"
                    android:id="@id/public_server_new_config_name"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:maxLength="80"
                    android:inputType="textCapSentences"
                    android:autofillHints="@null"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6.0dip">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@id/public_server_category_layout"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:hint="@string/category"
                    android:layout_weight="1.0"
                    app:placeholderText="@string/category_hint"
                    style="@style/Widget.App.TextInputLayout">
                    <com.google.android.material.textfield.TextInputEditText
                        android:textSize="14.0sp"
                        android:id="@id/public_server_category"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:maxLength="100"
                        android:inputType="textNoSuggestions"
                        android:autofillHints="@null"
                        android:importantForAutofill="no" />
                </com.google.android.material.textfield.TextInputLayout>
                <ImageView
                    android:id="@id/info_server_category"
                    android:background="?selectableItemBackgroundBorderless"
                    android:layout_width="@dimen/info_icon_size"
                    android:layout_height="@dimen/info_icon_size"
                    android:src="@drawable/ic_info_standard"
                    android:contentDescription="@string/info"
                    android:layout_marginStart="4.0dip"
                    app:tint="?android:textColorSecondary"
                    style="@style/Widget.App.InfoIcon" />
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6.0dip"
                android:hint="@string/note"
                style="@style/Widget.App.TextInputLayout">
                <com.google.android.material.textfield.TextInputEditText
                    android:textSize="14.0sp"
                    android:id="@id/public_server_note"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:maxLength="255"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:autofillHints="@null"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </ScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>