<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/mainBg"
    android:fitsSystemWindows="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@id/tool_bar"
        layout="@layout/tool_bar" />
    <androidx.core.widget.NestedScrollView
        android:id="@id/tools_scroll_container"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tool_bar">
        <LinearLayout
            android:orientation="vertical"
            android:padding="16.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@id/card_tool_intro"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12.0dip"
                app:cardElevation="2.0dip">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="20.0sp"
                        android:textStyle="bold"
                        android:id="@id/tv_tool_heading"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="14.0sp"
                        android:id="@id/tv_tool_description"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8.0dip"
                        android:lineSpacingExtra="2.0dip"
                        android:alpha="0.76" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12.0sp"
                        android:id="@id/tv_tool_notice"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12.0dip"
                        android:lineSpacingExtra="2.0dip"
                        android:alpha="0.68" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@id/card_tool_input"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14.0dip"
                app:cardCornerRadius="12.0dip"
                app:cardElevation="2.0dip">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@id/primary_input_row"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@id/primary_input_layout"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/tool_host_or_ip"
                            style="@style/Widget.App.TextInputLayout">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@id/primary_input"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:inputType="textUri"
                                android:imeOptions="actionGo" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@id/secondary_input_layout"
                        android:visibility="gone"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12.0dip"
                        android:hint="@string/tool_port"
                        style="@style/Widget.App.TextInputLayout">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@id/secondary_input"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:inputType="number"
                            android:imeOptions="actionGo" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@id/common_ports_container"
                        android:visibility="gone"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10.0dip">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="12.0sp"
                                android:textStyle="bold"
                                android:layout_width="0.0dip"
                                android:layout_height="wrap_content"
                                android:text="@string/tool_common_ports"
                                android:layout_weight="1.0"
                                android:alpha="0.72" />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="11.0sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tool_tap_to_fill"
                                android:alpha="0.55" />
                        </LinearLayout>
                        <HorizontalScrollView
                            android:scrollbars="none"
                            android:clipToPadding="false"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4.0dip"
                            android:fillViewport="false"
                            android:overScrollMode="ifContentScrolls">
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@id/common_ports_group"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="0.0dip"
                                android:paddingEnd="8.0dip" />
                        </HorizontalScrollView>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@id/dns_type_container"
                        android:visibility="gone"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12.0dip">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12.0sp"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tool_dns_record_type"
                            android:alpha="0.72" />
                        <androidx.appcompat.widget.AppCompatSpinner
                            android:entries="@array/tool_dns_record_types"
                            android:id="@id/dns_type_spinner"
                            android:background="@drawable/bg_network_tool_spinner"
                            android:layout_width="fill_parent"
                            android:layout_height="48.0dip"
                            android:layout_marginTop="4.0dip"
                            android:paddingStart="12.0dip"
                            android:paddingEnd="12.0dip" />
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@id/continuous_ping_container"
                        android:visibility="gone"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8.0dip"
                        android:minHeight="40.0dip">
                        <androidx.appcompat.widget.SwitchCompat
                            android:textSize="13.0sp"
                            android:gravity="center_vertical"
                            android:id="@id/switch_continuous_ping"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:text="@string/tool_ping_continuously" />
                    </LinearLayout>
                    <ProgressBar
                        android:id="@id/tool_progress"
                        android:visibility="gone"
                        android:layout_width="fill_parent"
                        android:layout_height="4.0dip"
                        android:layout_marginTop="10.0dip"
                        android:indeterminate="true"
                        style="?android:progressBarStyleHorizontal" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/tool_action_row"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14.0dip">
                <com.google.android.material.button.MaterialButton
                    android:id="@id/btn_my_ip"
                    android:visibility="gone"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:minHeight="40.0dip"
                    android:text="@string/tool_my_ip"
                    android:layout_weight="1.0"
                    android:insetTop="0.0dip"
                    android:insetBottom="0.0dip"
                    android:textAllCaps="false"
                    android:paddingStart="12.0dip"
                    android:paddingEnd="12.0dip"
                    android:layout_marginEnd="12.0dip"
                    app:cornerRadius="20.0dip"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                <com.google.android.material.button.MaterialButton
                    android:textSize="14.0sp"
                    android:typeface="sans"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:id="@id/btn_run_tool"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:minHeight="40.0dip"
                    android:text="@string/tool_run"
                    android:layout_weight="1.0"
                    android:insetTop="0.0dip"
                    android:insetBottom="0.0dip"
                    android:paddingStart="12.0dip"
                    android:paddingEnd="12.0dip"
                    app:backgroundTint="?colorAccent"
                    app:cornerRadius="20.0dip" />
            </LinearLayout>
            <androidx.cardview.widget.CardView
                android:id="@id/card_tool_results"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14.0dip"
                android:layout_marginBottom="8.0dip"
                app:cardCornerRadius="12.0dip"
                app:cardElevation="2.0dip">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12.0sp"
                            android:textStyle="bold"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:text="@string/tool_results"
                            android:layout_weight="1.0"
                            android:textAllCaps="true" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="10.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:id="@id/tv_result_status"
                            android:background="@drawable/bg_status_chip_info"
                            android:paddingTop="3.0dip"
                            android:paddingBottom="3.0dip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="10.0dip"
                            android:paddingEnd="10.0dip" />
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@id/result_rows"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8.0dip" />
                    <ScrollView
                        android:id="@id/result_raw_scroll"
                        android:visibility="gone"
                        android:scrollbars="vertical"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6.0dip"
                        android:fillViewport="false"
                        android:overScrollMode="ifContentScrolls">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12.0sp"
                            android:id="@id/tv_result_raw"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="0.0dip"
                            android:textIsSelectable="true"
                            android:fontFamily="monospace" />
                    </ScrollView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>