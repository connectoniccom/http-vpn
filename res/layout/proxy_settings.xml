<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/mainTetherBg"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@id/tool_bar"
        layout="@layout/tool_bar" />
    <ScrollView
        android:id="@id/mainContainerTetherBg"
        android:paddingTop="12.0dip"
        android:paddingBottom="18.0dip"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:paddingStart="12.0dip"
        android:paddingEnd="12.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tool_bar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@id/card_internet_sharing"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10.0dip"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12.0dip"
                app:cardElevation="1.5dip">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="12.0dip"
                    android:paddingBottom="12.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16.0dip"
                    android:paddingEnd="16.0dip">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="16.0sp"
                            android:typeface="sans"
                            android:textStyle="bold"
                            android:textColor="?android:textColorPrimary"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_internet_sharing" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12.0sp"
                            android:textColor="?android:textColorSecondary"
                            android:id="@id/tv_status"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5.0dip"
                            android:text="@string/ui_start_the_local_proxy_on_this_device" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@id/switch_tether"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="56.0dip"
                        android:minHeight="42.0dip"
                        android:layout_marginStart="12.0dip" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@id/card_connection_info"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10.0dip"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12.0dip"
                app:cardElevation="1.5dip">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="16.0sp"
                            android:typeface="sans"
                            android:textStyle="bold"
                            android:textColor="?android:textColorPrimary"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_connection_info"
                            android:layout_weight="1.0" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="10.0sp"
                            android:typeface="sans"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:id="@id/tv_status_chip"
                            android:background="@drawable/bg_status_chip_inactive"
                            android:paddingTop="3.0dip"
                            android:paddingBottom="3.0dip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_inactive"
                            android:paddingStart="10.0dip"
                            android:paddingEnd="10.0dip" />
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16.0dip">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="13.0sp"
                            android:textColor="?android:textColorSecondary"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_ip_address"
                            android:layout_weight="1.0" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="14.0sp"
                            android:typeface="sans"
                            android:textStyle="bold"
                            android:textColor="?android:textColorPrimary"
                            android:gravity="end"
                            android:id="@id/tv_address"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/not_available"
                            android:textIsSelectable="true" />
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10.0dip">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="13.0sp"
                            android:textColor="?android:textColorSecondary"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_port_number"
                            android:layout_weight="1.0" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="14.0sp"
                            android:typeface="sans"
                            android:textStyle="bold"
                            android:textColor="?android:textColorPrimary"
                            android:gravity="end"
                            android:id="@id/tv_port"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_value_8080"
                            android:textIsSelectable="true" />
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18.0dip"
                        android:baselineAligned="false">
                        <com.google.android.material.button.MaterialButton
                            android:textSize="13.0sp"
                            android:typeface="sans"
                            android:textStyle="bold"
                            android:textColor="?android:textColorPrimary"
                            android:id="@id/btn_copy_tethering"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:minHeight="48.0dip"
                            android:text="@string/ui_copy"
                            android:layout_weight="1.0"
                            android:textAllCaps="false"
                            android:layout_marginEnd="5.0dip"
                            app:cornerRadius="20.0dip"
                            app:icon="@drawable/ic_copy"
                            app:iconGravity="textStart"
                            app:iconPadding="6.0dip"
                            app:iconTint="?android:textColorPrimary"
                            app:strokeColor="?colorControlNormal"
                            app:strokeWidth="1.0dip"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                        <com.google.android.material.button.MaterialButton
                            android:textSize="13.0sp"
                            android:typeface="sans"
                            android:textStyle="bold"
                            android:textColor="?android:textColorPrimary"
                            android:id="@id/btn_share_tethering"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:minHeight="48.0dip"
                            android:text="@string/ui_share"
                            android:layout_weight="1.0"
                            android:textAllCaps="false"
                            android:layout_marginStart="5.0dip"
                            android:layout_marginEnd="5.0dip"
                            app:cornerRadius="20.0dip"
                            app:icon="@drawable/ic_share"
                            app:iconGravity="textStart"
                            app:iconPadding="6.0dip"
                            app:iconTint="?android:textColorPrimary"
                            app:strokeColor="?colorControlNormal"
                            app:strokeWidth="1.0dip"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@id/btn_refresh_tethering"
                            android:layout_width="48.0dip"
                            android:layout_height="wrap_content"
                            android:minHeight="48.0dip"
                            android:text=""
                            android:contentDescription="@string/ui_refresh_proxy_info"
                            android:layout_marginStart="5.0dip"
                            app:cornerRadius="20.0dip"
                            app:icon="@drawable/ic_reload"
                            app:iconGravity="textStart"
                            app:iconPadding="0.0dip"
                            app:iconTint="?android:textColorPrimary"
                            app:strokeColor="?colorControlNormal"
                            app:strokeWidth="1.0dip"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@id/card_statistics"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10.0dip"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12.0dip"
                app:cardElevation="1.5dip">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18.0dip"
                            android:layout_height="18.0dip"
                            android:src="@drawable/ic_tether_stats"
                            android:contentDescription="@null"
                            app:tint="?colorAccent" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="16.0sp"
                            android:typeface="sans"
                            android:textStyle="bold"
                            android:textColor="?android:textColorPrimary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_usage_statistics"
                            android:layout_marginStart="10.0dip" />
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14.0dip">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18.0dip"
                            android:layout_height="18.0dip"
                            android:src="@drawable/ic_tether_upload"
                            android:contentDescription="@null"
                            app:tint="?colorControlNormal" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="13.0sp"
                            android:textColor="?android:textColorSecondary"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:text="@string/upload"
                            android:layout_weight="1.0"
                            android:layout_marginStart="10.0dip" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="13.0sp"
                            android:typeface="sans"
                            android:textStyle="bold"
                            android:textColor="?android:textColorPrimary"
                            android:id="@id/tv_upload_rate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_value_0_kb_s" />
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9.0dip">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18.0dip"
                            android:layout_height="18.0dip"
                            android:src="@drawable/ic_tether_download"
                            android:contentDescription="@null"
                            app:tint="?colorControlNormal" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="13.0sp"
                            android:textColor="?android:textColorSecondary"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:text="@string/download"
                            android:layout_weight="1.0"
                            android:layout_marginStart="10.0dip" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="13.0sp"
                            android:typeface="sans"
                            android:textStyle="bold"
                            android:textColor="?android:textColorPrimary"
                            android:id="@id/tv_download_rate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_value_0_kb_s" />
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9.0dip">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18.0dip"
                            android:layout_height="18.0dip"
                            android:src="@drawable/ic_data_usage"
                            android:contentDescription="@null"
                            app:tint="?colorControlNormal" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="13.0sp"
                            android:textColor="?android:textColorSecondary"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_total_data"
                            android:layout_weight="1.0"
                            android:layout_marginStart="10.0dip" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="13.0sp"
                            android:typeface="sans"
                            android:textStyle="bold"
                            android:textColor="?android:textColorPrimary"
                            android:id="@id/tv_total_data"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_value_0_kb" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@id/cvThird"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10.0dip"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12.0dip"
                app:cardElevation="1.5dip">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18.0dip"
                            android:layout_height="18.0dip"
                            android:src="@drawable/ic_wifi_tethering"
                            android:contentDescription="@null"
                            app:tint="?colorAccent" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="16.0sp"
                            android:typeface="sans"
                            android:textStyle="bold"
                            android:textColor="?android:textColorPrimary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_how_to_share_over_wifi"
                            android:layout_marginStart="10.0dip" />
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="13.0sp"
                        android:textColor="?android:textColorPrimary"
                        android:id="@id/tvThird"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14.0dip"
                        android:text="@string/ui_value_1_enable_hotspot_or_join_the_same_wifi_network_n2_on"
                        android:lineSpacingExtra="3.0dip" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12.0sp"
                        android:textStyle="italic"
                        android:textColor="?android:textColorSecondary"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9.0dip"
                        android:text="@string/ui_no_companion_app_is_required_on_the_receiving_device" />
                    <com.google.android.material.button.MaterialButton
                        android:textSize="13.0sp"
                        android:typeface="sans"
                        android:textStyle="bold"
                        android:textColor="?android:textColorPrimary"
                        android:id="@id/btn_open_wifi_tethering"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16.0dip"
                        android:minHeight="48.0dip"
                        android:text="@string/ui_open_hotspot_settings"
                        android:textAllCaps="false"
                        app:cornerRadius="20.0dip"
                        app:icon="@drawable/ic_wifi_tethering"
                        app:iconGravity="textStart"
                        app:iconPadding="8.0dip"
                        app:iconTint="?android:textColorPrimary"
                        app:strokeColor="?colorControlNormal"
                        app:strokeWidth="1.0dip"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@id/card_usb"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12.0dip"
                app:cardElevation="1.5dip">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18.0dip"
                            android:layout_height="18.0dip"
                            android:src="@drawable/ic_usb"
                            android:contentDescription="@null"
                            app:tint="?colorAccent" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="16.0sp"
                            android:typeface="sans"
                            android:textStyle="bold"
                            android:textColor="?android:textColorPrimary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_usb_cable_sharing"
                            android:layout_marginStart="10.0dip" />
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="13.0sp"
                        android:textColor="?android:textColorPrimary"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14.0dip"
                        android:text="@string/ui_value_1_connect_the_phone_to_the_pc_with_a_usb_cable"
                        android:lineSpacingExtra="3.0dip" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12.0sp"
                        android:textStyle="italic"
                        android:textColor="?android:textColorSecondary"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9.0dip"
                        android:text="@string/ui_usb_tethering_keeps_the_same_proxy_port_open_over_the_cable" />
                    <com.google.android.material.button.MaterialButton
                        android:textSize="13.0sp"
                        android:typeface="sans"
                        android:textStyle="bold"
                        android:textColor="?android:textColorPrimary"
                        android:id="@id/btn_open_usb_tethering"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16.0dip"
                        android:text="@string/ui_open_usb_tethering"
                        android:textAllCaps="false"
                        app:cornerRadius="20.0dip"
                        app:icon="@drawable/ic_usb"
                        app:iconGravity="textStart"
                        app:iconPadding="8.0dip"
                        app:iconTint="?android:textColorPrimary"
                        app:strokeColor="?colorControlNormal"
                        app:strokeWidth="1.0dip"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>