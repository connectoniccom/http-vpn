<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/mainBg"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@id/tool_bar"
        layout="@layout/tool_bar_catalog" />
    <ProgressBar
        android:id="@id/public_configs_page_progress"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="2.0dip"
        android:max="100"
        android:progress="0"
        app:layout_constraintTop_toBottomOf="@id/tool_bar"
        style="?android:progressBarStyleHorizontal" />
    <FrameLayout
        android:id="@id/public_configs_content"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/public_configs_page_progress">
        <FrameLayout
            android:id="@id/public_configs_webview_container"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@id/public_configs_webview_fallback"
                android:padding="32.0dip"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="16.0sp"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/public_configs_load_failed" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:id="@id/public_configs_retry"
                    android:background="@drawable/bg_connect_button"
                    android:paddingLeft="24.0dip"
                    android:paddingTop="12.0dip"
                    android:paddingRight="24.0dip"
                    android:paddingBottom="12.0dip"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20.0dip"
                    android:text="@string/reload"
                    android:paddingHorizontal="24.0dip"
                    android:paddingVertical="12.0dip" />
            </LinearLayout>
        </FrameLayout>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@id/public_configs_download_progress"
            android:visibility="gone"
            android:layout_width="48.0dip"
            android:layout_height="48.0dip" />
        <FrameLayout
            android:id="@id/public_configs_loading_overlay"
            android:background="#66000000"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:background="#cc000000"
                android:paddingLeft="24.0dip"
                android:paddingTop="18.0dip"
                android:paddingRight="24.0dip"
                android:paddingBottom="18.0dip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24.0dip"
                android:paddingVertical="18.0dip">
                <ProgressBar
                    android:layout_width="56.0dip"
                    android:layout_height="56.0dip" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="15.0sp"
                    android:typeface="sans"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:id="@id/public_configs_loading_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12.0dip"
                    android:text="@string/loading_page" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>