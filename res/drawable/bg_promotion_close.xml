<?xml version="1.0" encoding="utf-8"?>
<ripple
    android:color="?colorControlHighlight"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <inset
            android:insetLeft="4.0dip"
            android:insetRight="4.0dip"
            android:insetTop="4.0dip"
            android:insetBottom="4.0dip">
            <shape
                android:shape="oval">
                <solid
                    android:color="?colorSurface" />
                <stroke
                    android:width="1.0dip"
                    android:color="?cardStrokeColor" />
            </shape>
        </inset>
    </item>
</ripple>