<?xml version="1.0" encoding="utf-8"?>
<selector
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_pressed="true">
        <shape>
            <solid
                android:color="#33ef5350" />
            <stroke
                android:width="1.0dip"
                android:color="#80ef5350" />
            <corners
                android:radius="18.0dip" />
        </shape>
    </item>
    <item>
        <shape>
            <solid
                android:color="#20ef5350" />
            <stroke
                android:width="1.0dip"
                android:color="#66ef5350" />
            <corners
                android:radius="18.0dip" />
        </shape>
    </item>
</selector>